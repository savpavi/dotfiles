#!/bin/sh
# dot-rgb: paint every OpenRGB device (RAM, mouse, Aura board + ARGB headers) one colour.
#
#   dot-rgb            colour of the active dwl theme (bar accent)
#   dot-rgb RRGGBB     a given colour (leading # optional)
#   dot-rgb off        lights off
#   dot-rgb boot       for openrgb-server.service: wait for detection, check it, paint
#
# Also the Logitech mouse/headset (Solaar) and the Epomaker HE75 Mag (iot_driver).
#
# Talks to the OpenRGB SDK server (openrgb-server.service, 127.0.0.1:6742), so it
# returns at once. Without the server it skips OpenRGB: a stand-alone openrgb run
# rescans every bus for ~10 s and fights the server/GUI for the devices.
set -eu

port=6742
state="${XDG_STATE_HOME:-$HOME/.local/state}/dwl-theme/theme.json"

# ASUS Aura board; DOT_RGB_AURA names the device (string search), DOT_RGB_ARGB_LEDS
# the LEDs per ARGB header.
aura=${DOT_RGB_AURA:-ASUS}
n=${DOT_RGB_ARGB_LEDS:-120}

# boot: run as ExecStartPost of the server. Detection takes ~10 s. Some starts read
# the HID devices wrong: the Aura board comes up without its mainboard zone (51
# bogus headers, no board LEDs) and the mouse without its Static mode, both at once.
# The tell: zone 0 is the fixed 2-LED mainboard zone, so resizing it must be refused.
# If it is not, exit 1 so systemd restarts the server (Restart=on-failure), at most
# DOT_RGB_BOOT_TRIES times (default 3); after that paint whatever was detected.
if [ "${1:-}" = boot ]; then
	for i in $(seq 30); do
		[ "$(openrgb -l 2>/dev/null | wc -l)" -ge "${DOT_RGB_DEVICES:-3}" ] && break
		sleep 1
	done
	tries="${XDG_RUNTIME_DIR:-/tmp}/dot-rgb-boot.tries"
	if openrgb -l 2>/dev/null | grep -q "$aura"; then
		case "$(openrgb -d "$aura" -m direct -z 0 -sz 1 2>&1)" in
		*"out of range"*) ;;
		*)
			t=$(cat "$tries" 2>/dev/null || echo 0)
			if [ "$t" -lt "${DOT_RGB_BOOT_TRIES:-3}" ]; then
				echo $((t + 1)) >"$tries"
				echo "dot-rgb: $aura board misread, restarting the server (try $((t + 1)))" >&2
				exit 1
			fi
			echo "dot-rgb: $aura board still misread, painting anyway" >&2
			;;
		esac
	fi
	rm -f "$tries"
	"$0" theme || true
	exit 0
fi

case "${1:-theme}" in
theme)
	[ -r "$state" ] || { echo "dot-rgb: no $state (dwl-theme init?)" >&2; exit 1; }
	c=$(jq -r '.bar.accent // empty' "$state")
	;;
off) c=off ;;
*) c=$1 ;;
esac
c=${c#\#}

if [ "$c" != off ] && ! printf '%s' "$c" | grep -qiE '^[0-9a-f]{6}$'; then
	echo "dot-rgb: not a colour: $c" >&2
	exit 2
fi

# Solaar owns the Logitech lights too and re-applies its saved colour when a device
# wakes up, so tell it the new colour as well (saved in its config.yaml). The G733
# only answers while it is switched on; failures are ignored. ~1 s each, so detached.
if command -v solaar >/dev/null; then
	if [ "$c" = off ]; then eff='{ID: 0}'; else eff="{ID: 1, color: 0x$c}"; fi
	(
		solaar config "G502 X PLUS" rgb_zone_1 "$eff"
		solaar config "G733 Gaming Headset" led_zone_1 "$eff"
		solaar config "G733 Gaming Headset" led_zone_2 "$eff"
	) >/dev/null 2>&1 &
fi

# Epomaker HE75 Mag (RongYuan RY5088) through iot_driver from monsgeek-akko-linux,
# which OpenRGB does not know. Needs a uaccess udev rule for 3151:502b/502f.
# This firmware has the dazzle byte the other way round (8 = rainbow, 7 = solid);
# --invert-dazzle is a local patch to iot_driver. Read-back is no proof: look at it.
# Over 2.4G the keyboard sleeps after a while and then does not answer; set-led still
# exits 0. So check with `iot_driver info` (non-zero while asleep) and, if it is not
# there, keep retrying in the background (every 5 s, up to DOT_RGB_KB_WAIT seconds,
# default 600) until a key press wakes it. A newer dot-rgb run replaces the old waiter,
# so the last colour wins.
he75() {
	timeout 8 iot_driver info >/dev/null 2>&1 || return 1
	if [ "$c" = off ]; then
		timeout 8 iot_driver set-led 0 >/dev/null 2>&1
	else
		timeout 8 iot_driver set-led --invert-dazzle 1 4 2 $((0x$(echo "$c" | cut -c1-2))) \
			$((0x$(echo "$c" | cut -c3-4))) $((0x$(echo "$c" | cut -c5-6))) >/dev/null 2>&1
	fi
	return 0
}
if command -v iot_driver >/dev/null; then
	kbpid="${XDG_RUNTIME_DIR:-/tmp}/dot-rgb-he75.pid"
	[ -r "$kbpid" ] && kill "$(cat "$kbpid")" 2>/dev/null
	rm -f "$kbpid"
	if ! he75; then
		(
			trap 'rm -f "$kbpid"' EXIT
			end=$(($(date +%s) + ${DOT_RGB_KB_WAIT:-600}))
			while [ "$(date +%s)" -lt "$end" ]; do
				sleep 5
				he75 && break
			done
		) </dev/null >/dev/null 2>&1 &
		echo $! >"$kbpid"
	fi
fi

# OpenRGB last; server up? (bash-free port check)
if ! ss -ltnH "sport = :$port" 2>/dev/null | grep -q .; then
	echo "dot-rgb: OpenRGB server not running (systemctl --user start openrgb-server)" >&2
	exit 0
fi

if [ "$c" = off ]; then
	exec openrgb -m off
fi
# Static keeps the colour on the device itself (Direct needs a live connection).
openrgb -m static -c "$c"

# ASUS Aura board: the three ADD_GEN2 headers (zones 1-3) start at 0 LEDs after every
# server start, so nothing reaches the case fans until they are resized, and only
# Direct was seen to drive them. The server holds the connection, so Direct stays on.
# Now and then a server start reads the board wrong (no mainboard zone, header 1 at
# zone 0), so zone 0 is resized too; on the normal layout that one just fails.
for z in 0 1 2 3; do
	openrgb -d "$aura" -m direct -z "$z" -sz "$n" >/dev/null 2>&1 || true
done
openrgb -d "$aura" -m direct -c "$c" >/dev/null 2>&1 || true
