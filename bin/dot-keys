#!/usr/bin/env bash
# Kısayol rehberi (SUPER + K).
#
#   dot-keys           savpavi-shell kısayol penceresini aç/kapat
#   dot-keys --text    terminale yazdır
#
# Kaynak: config/savpavi-shell/scripts/keybinds.py — Lua config'teki hl.bind
# satırları ve yanlarındaki yorumlar.
set -uo pipefail

shell="$HOME/dotfiles/config/savpavi-shell"

if [[ ${1:-} == "--text" ]]; then
  exec python3 "$shell/scripts/keybinds.py" --text
fi

# savpavi-shell çalışmıyorsa (ör. dot-shell switch ile DMS açıksa) listeyi terminalde göster.
if ! qs -p "$shell" ipc call keybinds toggle >/dev/null 2>&1; then
  exec kitty --class dot-keys -e sh -c 'dot-keys --text | less -S'
fi
