#!/usr/bin/env bash
# dot-grab — açık Brave Origin sekmesini veya panodaki linki yt-dlp / gallery-dl ile indirir.
# Kısayol: SUPER+SHIFT+D (Brave odaktaysa sekme, değilse pano), SUPER+CTRL+D (her zaman pano).
# Video siteleri → yt-dlp (~/Downloads/yt-dlp), görsel/galeri siteleri → gallery-dl (~/Downloads/gallery-dl).
# Bilinmeyen site önce yt-dlp, olmazsa gallery-dl, o da olmazsa sayfadaki doğrudan dosya linkleri (direct). Çerezler Brave Origin profilinden okunur (girişli içerik için; 25.10.2026'dan beri, önce Zen).
# Gerekli: yt-dlp ffmpeg gallery-dl (uv tool) wl-clipboard libnotify hyprctl. (11.10.2026)
# Kullanım: dot-grab [--clip|--tab] [--force] [--playlist] [URL...]
# Liste: spankbang liste kökü (…/<liste>/playlist/<ad>) kendiliğinden tüm liste olarak iner; listedeki tek video linki
# (…/<liste>-<video>/playlist/…) yalnız o videoyu indirir, --playlist ile o da tüm listeye çevrilir. Sınır GRAB_MAX_FILES. (19.11.2026)
# Panoda (veya argümanda) birden fazla link varsa hepsi sırayla indirilir, sonda tek özet bildirimi. (19.11.2026)
set -u -o pipefail

BROWSER_CLASS="brave-origin"
BRAVE_PROFILE="$HOME/.config/BraveSoftware/Brave-Origin/Default"
VIDEO_DIR="$HOME/Downloads/yt-dlp"
GALLERY_DIR="$HOME/Downloads/gallery-dl"
LOG_DIR="$HOME/.cache/dot-grab"

# GRAB_QUIET=1: bildirim yok (toplu indirmede her link için alt çağrı böyle çalışır; özeti üst çağrı verir).
ns() { [ "${GRAB_QUIET:-0}" = 1 ] && return 0; notify-send "$@"; }
notify() { ns -a "Grab" "$@"; }

mode=auto url="" force=0 playlist=0
for a in "$@"; do
    case "$a" in
        --clip) mode=clip ;;
        --tab)  mode=tab ;;
        --force) force=1 ;;
        --playlist) playlist=1 ;;
        *)      url="$url $a" ;;
    esac
done

# Tarayıcı adres çubuğundan URL'yi al: Ctrl+L, Ctrl+C, Esc; panonun eski içeriğini geri koy.
tab_url() {
    # Lua string'i içinde \. geçersiz kaçış; nokta kaçırılmadan bırakılır.
    local old new win="class:^${BROWSER_CLASS}\$"
    old="$(wl-paste --no-newline 2>/dev/null || true)"
    printf '' | wl-copy
    for k in L C; do
        hyprctl dispatch "hl.dsp.send_shortcut({mods='CTRL', key='$k', window='$win'})" >/dev/null
        sleep 0.15
    done
    sleep 0.2
    new="$(wl-paste --no-newline 2>/dev/null || true)"
    hyprctl dispatch "hl.dsp.send_shortcut({mods='', key='Escape', window='$win'})" >/dev/null
    if [ -n "$old" ]; then printf '%s' "$old" | wl-copy; fi
    printf '%s' "$new"
}

if [ -z "${url// /}" ]; then
    if [ "$mode" = auto ]; then
        active="$(hyprctl activewindow -j 2>/dev/null | sed -n 's/.*"class": *"\([^"]*\)".*/\1/p' | head -1)"
        [ "$active" = "$BROWSER_CLASS" ] && mode=tab || mode=clip
    fi
    if [ "$mode" = tab ]; then url="$(tab_url)"; else url="$(wl-paste --no-newline 2>/dev/null || true)"; fi
fi
# Metindeki bütün http(s) linkleri (satır/boşluk/virgülle ayrılmış olabilir), sırası korunarak tekilleştirilir.
mapfile -t urls < <(printf '%s\n' "$url" | grep -oE "https?://[^[:space:]<>\"',]+" | awk '!seen[$0]++')
if [ ${#urls[@]} -eq 0 ]; then
    notify "Link yok" "Geçerli bir http(s) linki bulunamadı (${mode})."; exit 1
fi

# Toplu indirme: her link kendi alt çağrısında (aynı korumalar ve sınırlar), sırayla; sonda tek özet.
if [ ${#urls[@]} -gt 1 ]; then
    n=${#urls[@]}
    if [ "$n" -gt "${GRAB_MAX_LINKS:-50}" ]; then
        notify -u critical "İndirilmedi: çok fazla link" "Panoda $n link var (sınır ${GRAB_MAX_LINKS:-50}). Yanlış metin kopyalanmış olabilir."
        exit 2
    fi
    fargs=(); [ "$force" -eq 1 ] && fargs=(--force); [ "$playlist" -eq 1 ] && fargs+=(--playlist)
    ok=0 skip=0 fail=0 i=0 bad=()
    bid="$(ns -a Grab -p "Toplu indirme: $n link" "Başlıyor…" 2>/dev/null || true)"
    brep=(); [ -n "$bid" ] && brep=(-r "$bid")
    for u in "${urls[@]}"; do
        i=$((i + 1))
        ns -a Grab "${brep[@]}" "Toplu indirme: $i/$n" "$u" >/dev/null 2>&1 || true
        GRAB_QUIET=1 "$0" "${fargs[@]}" "$u" </dev/null
        case $? in
            0) ok=$((ok + 1)) ;;
            2) skip=$((skip + 1)); bad+=("akış: $u") ;;
            *) fail=$((fail + 1)); bad+=("hata: $u") ;;
        esac
    done
    msg="$ok indi"; [ $skip -gt 0 ] && msg="$msg, $skip akış linki atlandı"; [ $fail -gt 0 ] && msg="$msg, $fail hata"
    [ ${#bad[@]} -gt 0 ] && msg="$msg"$'\n'"$(printf '%s\n' "${bad[@]}" | head -5 | cut -c1-120)"
    urg=(); [ $((skip + fail)) -gt 0 ] && urg=(-u critical)
    act="$(ns -a Grab "${brep[@]}" "${urg[@]}" -A open="Downloads'u aç" -A log="Logları aç" "Toplu indirme bitti ($ok/$n)" "$msg" 2>/dev/null || true)"
    case "$act" in
        open) setsid -f xdg-open "$HOME/Downloads" >/dev/null 2>&1 ;;
        log)  setsid -f xdg-open "$LOG_DIR" >/dev/null 2>&1 ;;
    esac
    [ $fail -eq 0 ] && [ $skip -eq 0 ] && exit 0
    [ $ok -gt 0 ] && exit 0 || exit 1
fi
url="${urls[0]}"

host="$(printf '%s' "$url" | sed -E 's#^https?://([^/:]+).*#\1#; s#^www\.##; s#^m\.##')"
path="$(printf '%s' "$url" | sed -E 's#^https?://[^/]+##; s#[?#].*##; s#/+$##')"

# Akış koruması: ana sayfa, keşfet, arama, hesap sayfası gibi sonsuz akışlar indirilmez; yalnız tek gönderi linki.
# (11.10.2026: sekme modu x.com/home'da tetiklendi, gallery-dl 70 dk'da 52 GB indirdi.) Bilerek istenirse: --force
single_post() {
    case "$host" in
        x.com|twitter.com|mobile.twitter.com|fixupx.com|vxtwitter.com)
            [[ $path =~ ^/[^/]+/status/[0-9]+ ]] ;;
        instagram.com)
            [[ $path =~ ^/(p|reel|reels|tv)/[^/]+ || $path =~ ^/[^/]+/(p|reel)/[^/]+ ]] ;;
        reddit.com|*.reddit.com)
            [[ $path =~ /comments/[^/]+ || $path =~ ^/gallery/[^/]+ ]] ;;
        redd.it) [[ -n $path ]] ;;
        bsky.app) [[ $path =~ ^/profile/[^/]+/post/[^/]+ ]] ;;
        youtube.com|music.youtube.com)   # kanal / oynatma listesi sayfası bütün kanalı indirir
            [[ $path =~ ^/(watch|shorts/|live/|embed/) ]] ;;
        pinterest.*) [[ $path =~ ^/pin/[^/]+ ]] ;;
        tumblr.com) [[ $path =~ ^/[^/]+/[0-9]+ ]] ;;
        *.tumblr.com) [[ $path =~ ^/post/[0-9]+ ]] ;;
        *) [[ -n $path ]] ;;   # kök adres (site ana sayfası) hiçbir sitede indirilmez
    esac
}
# X profili (x.com/kullanici veya /media) → yalnız medya sekmesi; sınır aşağıdaki GRAB_MAX_FILES/GRAB_TIMEOUT. (24.10.2026)
x_profile() {
    case "$host" in x.com|twitter.com|mobile.twitter.com) ;; *) return 1 ;; esac
    [[ $path =~ ^/([A-Za-z0-9_]{1,15})(/(media|with_replies|highlights))?$ ]] || return 1
    case "${BASH_REMATCH[1],,}" in
        home|explore|search|notifications|messages|i|settings|compose|login|logout|signup|tos|privacy|jobs|hashtag|lists|bookmarks) return 1 ;;
    esac
    url="https://x.com/${BASH_REMATCH[1]}/media"
}
if [ "$force" -eq 0 ] && x_profile; then
    :
elif [ "$force" -eq 0 ] && ! single_post; then
    notify -u critical "İndirilmedi: akış linki" "$host${path:-/} tek bir gönderi değil (ana sayfa/hesap/keşfet). Bilerek istiyorsan: dot-grab --force URL"
    exit 2
fi

# Brave Origin çerezleri. Anahtar GNOME Keyring'de ("Brave Safe Storage"); Hyprland'de otomatik seçim yanlış
# anahtarlığa düşüp v11 çerezleri çözemiyor, o yüzden +gnomekeyring açık yazılı. secretstorage gerekir:
# uv tool install --force 'yt-dlp[default]' --with secretstorage (gallery-dl için de aynı). (25.10.2026)
cookie_args=()
[ -f "$BRAVE_PROFILE/Cookies" ] && cookie_args=(--cookies-from-browser "brave+gnomekeyring:$BRAVE_PROFILE")

case "$host" in
    youtube.com|youtu.be|music.youtube.com|twitch.tv|*.twitch.tv|vimeo.com|dailymotion.com|tiktok.com|*.tiktok.com|kick.com|soundcloud.com|rumble.com|bilibili.com)
        tools=(yt) ;;
    # Reddit gallery-dl'nin anonim API isteklerini "blocked by network security" ile reddediyor (çerezle de);
    # yt-dlp videoyu indiriyor. Önce yt-dlp, görsel/galeri gönderisinde gallery-dl. (13.11.2026)
    reddit.com|*.reddit.com|redd.it|v.redd.it)
        tools=(yt gallery) ;;
    instagram.com|x.com|twitter.com|imgur.com|pixiv.net|pinterest.*|*.tumblr.com|tumblr.com|deviantart.com|artstation.com|bsky.app|imgbox.com|flickr.com|catbox.moe)
        tools=(gallery) ;;
    *)  tools=(yt gallery direct) ;;
esac
# Yerel ek liste (repoda değil): her satır bir gallery-dl alan adı deseni, ör. "*.example.com"
EXTRA="${XDG_CONFIG_HOME:-$HOME/.config}/dot-grab/gallery-domains"
if [ "${tools[*]}" != gallery ] && [ -f "$EXTRA" ]; then
    while IFS= read -r pat; do
        pat="${pat%%#*}"; pat="${pat//[[:space:]]/}"
        [ -n "$pat" ] || continue
        # shellcheck disable=SC2053
        [[ $host == $pat ]] && { tools=(gallery); break; }
    done <"$EXTRA"
fi

# Liste modu: spankbang liste kökü kendiliğinden; --playlist ile listedeki video linki liste köküne çevrilir.
case "$host$path" in
    spankbang.com/*/playlist/*)
        if [ "$playlist" -eq 1 ]; then url="$(printf '%s' "$url" | sed -E 's#(spankbang\.com/[a-z0-9]+)-[a-z0-9]+/playlist/#\1/playlist/#')"
        elif ! printf '%s' "$path" | grep -qE '^/[a-z0-9]+-[a-z0-9]+/playlist/'; then playlist=1; fi ;;
esac

mkdir -p "$LOG_DIR" "$VIDEO_DIR" "$GALLERY_DIR"
log="$LOG_DIR/$(date +%Y%m%d-%H%M%S)-${host//[^A-Za-z0-9.]/_}.log"
nid="$(ns -a Grab -p "İndiriliyor…" "$host" 2>/dev/null || true)"
replace=(); [ -n "$nid" ] && replace=(-r "$nid")

run_yt() {
    local pl=(--no-playlist) out="$VIDEO_DIR/%(title).150B [%(id)s].%(ext)s"
    if [ "$playlist" -eq 1 ]; then
        pl=(--yes-playlist --ignore-errors --playlist-end "${GRAB_MAX_FILES:-300}" --download-archive "$LOG_DIR/playlist-archive.txt")
        out="$VIDEO_DIR/%(playlist_title,playlist_id|liste).100B/%(title).150B [%(id)s].%(ext)s"
    fi
    yt-dlp "${pl[@]}" --newline --no-progress \
        -f "bv*+ba/b" -S "res:1080" --merge-output-format mp4 --embed-metadata \
        --js-runtimes node "${cookie_args[@]}" \
        -o "$out" \
        --no-simulate --print after_move:filepath "$url"
}
# İkinci emniyet: bir çağrı en fazla GRAB_MAX_FILES dosya ve GRAB_TIMEOUT süre (--force ile de geçerli).
run_gallery() {
    timeout "${GRAB_TIMEOUT:-20m}" gallery-dl "${cookie_args[@]}" --range "1-${GRAB_MAX_FILES:-300}" \
        -d "$GALLERY_DIR" "$url"
}

# Son çare: iki araç da siteyi tanımıyorsa (ör. fileditchalbums.st) sayfadaki doğrudan dosya linklerini
# (href/src) toplar ve yt-dlp ile indirir; video/arşiv varsa yalnız onlar, yoksa görseller. Klasör = sayfa başlığı.
# Büyük albümler için timeout yok; dosya sınırı GRAB_MAX_FILES. (30.10.2026)
run_direct() {
    local page origin title links media='mp4|mkv|webm|mov|m4v|avi|wmv|flv|ts|zip|rar|7z' img='jpe?g|png|gif|webp|avif'
    page="$(curl -sfL -m 30 -A 'Mozilla/5.0 (X11; Linux x86_64)' "$url")" || return 1
    origin="$(printf '%s' "$url" | sed -E 's#^(https?://[^/]+).*#\1#')"
    pick() {
        printf '%s' "$page" | grep -oiE "(href|src)=[\"'][^\"']+\.($1)([?#][^\"']*)?[\"']" |
            sed -E "s/^[a-zA-Z]+=[\"']//; s/[\"']\$//; s/&amp;/\\&/g; s#^//#https://#; s#^/#$origin/#" |
            grep -E '^https?://' | awk '!seen[$0]++' | head -n "${GRAB_MAX_FILES:-300}"
    }
    links="$(pick "$media")"
    [ -n "$links" ] || links="$(pick "$img")"
    [ -n "$links" ] || { echo "ERROR: direct: sayfada doğrudan dosya linki yok" >&2; return 1; }
    title="$(printf '%s' "$page" | tr '\n' ' ' | sed -nE 's#.*<title[^>]*>([^<]*)</title>.*#\1#Ip' |
        sed -E 's/ [·|–-] [^·|–-]*$//; s#[/\\:*?"<>|]#_#g; s/^[[:space:].]+//; s/[[:space:]]+$//' | cut -c1-100)"
    echo "direct: $(printf '%s\n' "$links" | wc -l) link" >&2
    printf '%s\n' "$links" | yt-dlp --ignore-errors --newline --no-progress -a - \
        -o "$VIDEO_DIR/${title:-$host}/%(title).150B.%(ext)s" \
        --no-simulate --print after_move:filepath
    return 0
}

ok=0 used=""
for t in "${tools[@]}"; do
    used="$t"
    echo "== $t: $url" >>"$log"
    # Çıktı önce yakalanıp sonra loga eklenir (aynı pipeline'da $log'u okuyup yazmamak için, SC2094).
    rc=1
    case "$t" in
        yt) out="$(run_yt 2>>"$log")"; rc=$?
            # Çerezler okunamazsa (ör. anahtarlıkta bozuk kayıt: "Item does not exist!") yt-dlp
            # hiç denemeden çıkıyor; çerezsiz bir kez daha dene. (13.11.2026)
            if [ $rc -ne 0 ] && [ ${#cookie_args[@]} -gt 0 ] &&
               tail -n 3 "$log" | grep -qiE 'Item does not exist|could not (find|decrypt)|cookie'; then
                echo "== yt: çerezler okunamadı, çerezsiz deneniyor" >>"$log"
                cookie_args=()
                out="$(run_yt 2>>"$log")"; rc=$?
            fi ;;
        gallery) out="$(run_gallery 2>>"$log")"; rc=$? ;;
        direct) out="$(run_direct 2>>"$log")"; rc=$?
            # --ignore-errors: bazı dosyalar inmese de inenler başarı sayılır
            [ $rc -eq 0 ] && [ -z "$out" ] && rc=1 ;;
    esac
    [ -n "$out" ] && printf '%s\n' "$out" >>"$log"
    # gallery-dl hiçbir şey indirmediyse (zaten varsa '# ' önekli satır yazar) bunu da başarı say
    if [ $rc -eq 0 ]; then ok=1; break; fi
done

if [ $ok -eq 1 ]; then
    count="$(printf '%s\n' "$out" | grep -c . || true)"
    # Fonksiyonlar $( ) içinde (alt kabukta) çalıştığı için klasör burada belirlenir.
    last="$(printf '%s\n' "$out" | tail -1 | sed 's/^# //')"
    name="$(basename "$last")"
    dir="$([ "$used" = gallery ] && echo "$GALLERY_DIR" || echo "$VIDEO_DIR")"
    [ -n "$last" ] && [ -d "$(dirname "$last")" ] && dir="$(dirname "$last")"
    msg="$name"; [ "$count" -gt 1 ] && msg="$count dosya — son: $name"
    [ "$count" -eq 0 ] && msg="Yeni dosya yok (zaten indirilmiş olabilir)"
    act="$(ns -a Grab "${replace[@]}" -A open="Klasörü aç" "Bitti ($(case "$used" in yt) echo yt-dlp ;; gallery) echo gallery-dl ;; *) echo direkt link ;; esac))" "$msg" 2>/dev/null || true)"
    [ "$act" = open ] && setsid -f xdg-open "$dir" >/dev/null 2>&1
    exit 0
fi

err="$(grep -E 'ERROR|\[error\]' "$log" | tail -1 | cut -c1-200)"
act="$(ns -a Grab -u critical "${replace[@]}" -A log="Logu aç" "İndirilemedi: $host" "${err:-ayrıntılar logda}" 2>/dev/null || true)"
[ "$act" = log ] && setsid -f xdg-open "$log" >/dev/null 2>&1
exit 1
