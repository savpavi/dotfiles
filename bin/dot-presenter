#!/usr/bin/env python3
"""Odaklı monitörde çizim katmanını aç/kapat."""
import os,json,subprocess as sp,sys,fcntl
from pathlib import Path
unit='dot-presenter.service'
with (Path(os.environ['XDG_RUNTIME_DIR'])/'dot-presenter.lock').open('w') as lock:
    try:fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
    except BlockingIOError:raise SystemExit(0)
    if sp.run(['systemctl','--user','is-active','--quiet',unit]).returncode==0:
        raise SystemExit(sp.run(['systemctl','--user','stop',unit]).returncode)
    output=json.loads(sp.check_output(['niri','msg','-j','focused-output']))['name']
    binary=Path.home()/'.local/lib/quickshell-fedora/usr/bin/quickshell'
    if not binary.exists():raise SystemExit('Quickshell runtime eksik')
    args=['systemd-run','--user','--collect','--unit='+unit,'--service-type=exec','--setenv=PRESENTER_OUTPUT='+output,'--setenv=PRESENTER_MODE='+('spotlight' if '--spotlight' in sys.argv else 'draw'),'--setenv=WAYLAND_DISPLAY='+os.environ['WAYLAND_DISPLAY'],'--',str(binary),'-p',str(Path.home()/'.config/quickshell/niri-presenter')]
    raise SystemExit(sp.run(args).returncode)
