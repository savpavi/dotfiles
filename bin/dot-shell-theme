#!/usr/bin/env python3
"""savpavi-shell temaları: palet, uygulama renkleri, duvar kağıdı, imleç.

Kaynak: config/savpavi-shell/themes (themes.json + palettes/, Noctalia'dan taşındı).
  dot-shell-theme build        tema renklerini shell'in okuduğu JSON'lara çevirir
  dot-shell-theme pick         fuzzel ile tema seç ve uygula
  dot-shell-theme apply <id>   temayı uygula (palet + mod + duvar kağıdı + hareketli duvar)
  dot-shell-theme wall [N]     aktif temanın sıradaki (ya da N'inci) duvar kağıdı
  dot-shell-theme walls        aktif temanın duvar kağıtları (JSON, seçici için)
  dot-shell-theme apps         aktif temanın renklerini uygulamalara yaz (DMS yokken apply bunu kendi yapar)
  dot-shell-theme live-active  aktif temanın hareketli duvarı var mı (çıkış kodu)
  dot-shell-theme list         tema kimlikleri
  dot-shell-theme json         bar seçicisi için tema listesi (JSON)
"""
import json, subprocess as sp, sys, time
from pathlib import Path

HOME = Path.home()
SRC = HOME/'dotfiles/config/savpavi-shell/themes'
THEMES = SRC/'themes.json'
PALETTES = SRC/'palettes'
OUT = HOME/'.local/share/savpavi-shell/themes'
STATE = HOME/'.local/state/savpavi-shell/theme.json'

# Tema -> imleç (XCursor adı; ~/.local/share/icons). Nord'da hyprcursor sürümü de var.
CURSORS = {
    'dwm-catppuccin': 'catppuccin-mocha-dark-cursors',
    'dwm-catppuccin-latte': 'catppuccin-latte-light-cursors',
    'dwm-dracula': 'Dracula-cursors',
    'dwm-everforest': 'everforest-cursors',
    'dwm-gruvbox': 'Capitaine Cursors (Gruvbox)',
    'dwm-gruvbox-light': 'Capitaine Cursors (Gruvbox) - White',
    'dwm-monochrome': 'Bibata-Modern-Classic',
    'dwm-nord': 'Nordzy-cursors',
    'dwm-one-dark': 'catppuccin-macchiato-blue-cursors',
    'dwm-rose-pine': 'BreezeX-RosePine-Linux',
    'dwm-rose-pine-dawn': 'BreezeX-RosePineDawn-Linux',
    'dwm-solarized': 'Bibata-Modern-Amber',
    'dwm-solarized-light': 'Bibata-Modern-Ice',
    'dwm-tokyo-night': 'Capitaine Cursors (Palenight)',
    'dwm-tokyo-night-day': 'catppuccin-latte-blue-cursors',
}
HYPRCURSORS = {'Nordzy-cursors': 'Nordzy-hyprcursors'}
CURSOR_SIZE = 24

def mix(a, b, t):
    a, b = a.lstrip('#'), b.lstrip('#')
    c = [round(int(a[i:i+2], 16)*(1-t) + int(b[i:i+2], 16)*t) for i in (0, 2, 4)]
    return '#%02x%02x%02x' % tuple(c)

def convert(p):
    """Palet modu -> shell renk anahtarları (DMS custom theme biçimi; DMS yedeği de okur)."""
    s, v, term = p['mSurface'], p['mSurfaceVariant'], p.get('terminal', {}).get('normal', {})
    return {
        'primary': p['mPrimary'], 'primaryText': p['mOnPrimary'],
        'primaryContainer': mix(p['mPrimary'], s, 0.6),
        'secondary': p['mSecondary'], 'surfaceTint': p['mPrimary'],
        'surface': s, 'surfaceText': p['mOnSurface'],
        'surfaceVariant': v, 'surfaceVariantText': p['mOnSurfaceVariant'],
        'background': s, 'backgroundText': p['mOnSurface'],
        'outline': mix(p['mOnSurfaceVariant'], s, 0.45),
        'surfaceContainerLowest': mix(s, v, 0.0), 'surfaceContainerLow': mix(s, v, 0.2),
        'surfaceContainer': mix(s, v, 0.4), 'surfaceContainerHigh': mix(s, v, 0.7),
        'surfaceContainerHighest': v,
        'error': p['mError'], 'warning': term.get('yellow', p['mTertiary']),
        'info': term.get('blue', p['mSecondary']),
    }

def themes():
    return json.loads(THEMES.read_text())['themes']

# Uygulama renkleri: templates/apps şablonları (DMS matugen şablonları, MIT)
# temanın kendi paletiyle doldurulur. Yedek shell DMS çalışırken bu işi DMS yapar.
APP_TEMPLATES = HOME/'dotfiles/templates/apps'
CFG, DATA = HOME/'.config', HOME/'.local/share'
APP_OUTPUTS = [
    ('gtk-colors.css', CFG/'gtk-4.0/savpavi-colors.css'),
    ('qtct-colors.conf', CFG/'qt5ct/colors/savpavi.conf'),
    ('qtct-colors.conf', CFG/'qt6ct/colors/savpavi.conf'),
    ('kcolorscheme.colors', DATA/'color-schemes/Savpavi.colors'),
    ('light-kcolorscheme.colors', DATA/'color-schemes/SavpaviLight.colors'),
    ('dark-kcolorscheme.colors', DATA/'color-schemes/SavpaviDark.colors'),
    ('kitty.conf', CFG/'kitty/savpavi-theme.conf'),
    ('kitty-tabs.conf', CFG/'kitty/savpavi-tabs.conf'),
    ('vesktop.css', CFG/'vesktop/themes/savpavi.css'),
    ('vesktop.css', CFG/'Vencord/themes/savpavi.css'),
    ('dank-zed.json', CFG/'zed/themes/savpavi.json'),
    ('zen-userchrome.css', DATA/'savpavi-shell/zen.css'),
    ('hypr-colors.lua', CFG/'hypr/savpavi/colors.lua'),
    ('btop.theme', CFG/'btop/themes/savpavi.theme'),
]

def roles(p):
    """Palet modu -> Material renk rolleri (matugen adlarıyla)."""
    s, v = p['mSurface'], p['mSurfaceVariant']
    on_s, on_v = p['mOnSurface'], p['mOnSurfaceVariant']
    r = {
        'background': s, 'on_background': on_s, 'surface': s, 'on_surface': on_s,
        'surface_variant': v, 'on_surface_variant': on_v,
        'surface_dim': mix(s, '#000000', 0.15), 'surface_bright': mix(s, v, 0.85),
        'surface_container_lowest': mix(s, '#000000', 0.2), 'surface_container_low': mix(s, v, 0.2),
        'surface_container': mix(s, v, 0.4), 'surface_container_high': mix(s, v, 0.7),
        'surface_container_highest': v,
        'outline': mix(on_v, s, 0.45), 'outline_variant': mix(v, on_s, 0.12),
        'inverse_surface': on_s, 'inverse_on_surface': s, 'inverse_primary': mix(p['mPrimary'], s, 0.35),
        'shadow': p.get('mShadow', '#000000'), 'scrim': p.get('mShadow', '#000000'),
        'surface_tint': p['mPrimary'], 'source_color': p['mPrimary'],
    }
    for name, key in (('primary', 'Primary'), ('secondary', 'Secondary'), ('tertiary', 'Tertiary'), ('error', 'Error')):
        c, on = p[f'm{key}'], p[f'mOn{key}']
        r[name], r[f'on_{name}'] = c, on
        r[f'{name}_container'], r[f'on_{name}_container'] = mix(c, s, 0.6), on_s
        if name != 'error':
            r[f'{name}_fixed'], r[f'{name}_fixed_dim'] = c, c
            r[f'on_{name}_fixed'], r[f'on_{name}_fixed_variant'] = on, on
    return r

def dank16(p):
    """Terminal paleti -> dank16 color0..15."""
    t = p.get('terminal', {})
    order = ('black', 'red', 'green', 'yellow', 'blue', 'magenta', 'cyan', 'white')
    out = {}
    for i, n in enumerate(order):
        out[f'color{i}'] = t.get('normal', {}).get(n, p['mOnSurface'])
        out[f'color{i + 8}'] = t.get('bright', {}).get(n, out[f'color{i}'])
    return out

def fmt(hexc, field):
    h = hexc.lstrip('#').lower()
    if field == 'hex':
        return '#' + h
    if field == 'hex_stripped':
        return h
    return str(int(h[{'red': 0, 'green': 2, 'blue': 4}[field]:][:2], 16))

def render_apps(tid, mode):
    """Aktif temanın renklerini uygulama config'lerine yazar, açık olanları tazeler."""
    import re
    t = next(x for x in themes() if x['id'] == tid)
    pal = json.loads((PALETTES/f"{t['palette']}.json").read_text())
    dark = pal.get('dark') or pal['light']
    light = pal.get('light') or dark
    ctx = {'dark': dark, 'light': light, 'default': light if mode == 'light' else dark}
    cache = {k: (roles(p), dank16(p)) for k, p in ctx.items()}

    def sub(m):
        ns, name, variant, field = m.group(1), m.group(2), m.group(3), m.group(4)
        table = cache[variant][0 if ns == 'colors' else 1]
        if name not in table:
            return m.group(0)
        return fmt(table[name], field)

    pat = re.compile(r'\{\{\s*(colors|dank16)\.([a-z0-9_]+)\.(default|dark|light)\.(hex_stripped|hex|red|green|blue)\s*\}\}')
    outputs = APP_OUTPUTS + [('gtk-light-colors.css' if mode == 'light' else 'gtk-colors.css', CFG/'gtk-3.0/savpavi-colors.css')]
    for src, dst in outputs:
        text = pat.sub(sub, (APP_TEMPLATES/src).read_text())
        # şablonlardaki DMS adları: Zed tema adı, KDE şema adı
        text = (text.replace('DankShell', 'Savpavi').replace('DankMatugen', 'Savpavi')
                .replace('DMS Matugen hook', 'dot-shell-theme').replace('require("dms.colors")', 'require("savpavi.colors")'))
        left = re.findall(r'\{\{[^}]*\}\}', text)
        if left:
            print(f"uyarı: {src} içinde doldurulmayan {len(left)} yer tutucu: {left[0]}", file=sys.stderr)
        dst.parent.mkdir(parents=True, exist_ok=True)
        dst.write_text(text)
    # açık uygulamaları tazele: kitty (SIGUSR1), Hyprland kenarlıkları, GTK
    sp.run(['pkill', '-USR1', '-x', 'kitty'], capture_output=True)
    sp.run(['hyprctl', 'reload', 'config-only'], capture_output=True)
    sp.run(['gsettings', 'set', 'org.gnome.desktop.interface', 'color-scheme',
            'prefer-light' if mode == 'light' else 'prefer-dark'], capture_output=True)

def dms_running():
    return sp.run(['pgrep', '-f', 'dms run'], capture_output=True).returncode == 0

def build():
    OUT.mkdir(parents=True, exist_ok=True)
    for t in themes():
        pal = json.loads((PALETTES/f"{t['palette']}.json").read_text())
        data = {'id': t['id'], 'name': t['title']}
        for mode in ('dark', 'light'):
            if mode in pal:
                data[mode] = convert(pal[mode])
        (OUT/f"{t['id']}.json").write_text(json.dumps(data, indent=2, ensure_ascii=False))
    print(f"{len(themes())} tema -> {OUT}")

def dms(*args):
    # yalnız yedek shell DMS açıkken; değilse boşa çağrı yapma
    if dms_running():
        sp.run(['dms', 'ipc', 'call', *args], capture_output=True, text=True, timeout=10)

def load_state():
    try:
        return json.loads(STATE.read_text())
    except (OSError, ValueError):
        return {}

def apply(tid, wall_index=None):
    t = next((x for x in themes() if x['id'] == tid), None)
    if t is None:
        sys.exit(f"tema yok: {tid}")
    path = OUT/f"{tid}.json"
    if not path.exists():
        build()
    walls = t.get('wallpapers') or []
    i = t.get('wallpaperIndex', 0) if wall_index is None else wall_index
    dms('theme', t.get('mode', 'dark'))
    dms('settings', 'set', 'customThemeFile', str(path))
    dms('settings', 'set', 'currentThemeName', 'custom')
    if walls:
        dms('wallpaper', 'set', walls[i % len(walls)])
    item = live(tid, i)
    if wall_index is None and tid in CURSORS:
        set_cursor(CURSORS[tid])
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps({'id': tid, 'mode': t.get('mode', 'dark'), 'wall': i % len(walls) if walls else 0,
                                  'wallpaper': walls[i % len(walls)] if walls else '', 'live': item}))
    if item is not None:
        # ExecCondition durum dosyasını okuyor; servis yazımdan sonra başlamalı
        sp.run(['systemctl', '--user', 'start', 'waywallen-layer-shell.service'], capture_output=True)
    if wall_index is None and not dms_running():
        render_apps(tid, t.get('mode', 'dark'))

def set_cursor(name):
    """İmleci canlı değiştirir; GTK/X11 ayarlarına ve Hyprland'in açılış dosyasına yazar."""
    if not (HOME/'.local/share/icons'/name/'cursors').is_dir():
        return
    sp.run(['hyprctl', 'setcursor', HYPRCURSORS.get(name, name), str(CURSOR_SIZE)], capture_output=True)
    sp.run(['gsettings', 'set', 'org.gnome.desktop.interface', 'cursor-theme', name], capture_output=True)
    default = HOME/'.icons/default/index.theme'
    default.parent.mkdir(parents=True, exist_ok=True)
    default.write_text(f"[Icon Theme]\nName=Default\nComment=Default Cursor Theme\nInherits={name}\n")
    for ini in (HOME/'.config/gtk-3.0/settings.ini', HOME/'.config/gtk-4.0/settings.ini'):
        if ini.exists():
            lines = [f"gtk-cursor-theme-name={name}" if l.startswith('gtk-cursor-theme-name=') else l
                     for l in ini.read_text().splitlines()]
            ini.write_text('\n'.join(lines) + '\n')
    # Hyprland açılışta imleci buradan alır (hyprland.lua: require "savpavi.cursor")
    (HOME/'.config/hypr/savpavi').mkdir(parents=True, exist_ok=True)
    (HOME/'.config/hypr/savpavi/cursor.lua').write_text(
        f'hl.env("HYPRCURSOR_THEME", "{HYPRCURSORS.get(name, name)}")\n'
        f'hl.env("XCURSOR_THEME", "{name}")\n'
        f'hl.env("HYPRCURSOR_SIZE", "{CURSOR_SIZE}")\nhl.env("XCURSOR_SIZE", "{CURSOR_SIZE}")\n')
    if not dms_running():
        return
    # Yedek shell DMS açıksa onun imleç ayarını da güncelle.
    # DMS IPC nesne ayarı yazamıyor; dosyayı düzenle. Önceki IPC set'lerinin
    # gecikmeli kaydı dosyayı ezebildiği için DMS değeri alana kadar tekrarla.
    cfg = HOME/'.config/DankMaterialShell/settings.json'
    for _ in range(8):
        time.sleep(0.4)
        r = sp.run(['dms', 'ipc', 'call', 'settings', 'get', 'cursorSettings'], capture_output=True, text=True, timeout=10)
        try:
            if json.loads(r.stdout).get('theme') == name:
                return
        except ValueError:
            pass
        try:
            d = json.loads(cfg.read_text())
            d.setdefault('cursorSettings', {})['theme'] = name
            cfg.write_text(json.dumps(d, indent=2, ensure_ascii=False))
        except (OSError, ValueError):
            return

# Hareketli duvar: waywallen (Flatpak) + waywallen-layer-shell user servisi.
# Tema -> Wallpaper Engine Workshop id listesi kişisel; repoda değil.
LIVE = HOME/'.config/savpavi-shell/live.json'
WW_DB = HOME/'.var/app/org.waywallen.waywallen/data/waywallen/waywallen-v2.db'
WW_DBUS = ['gdbus', 'call', '--session', '-d', 'org.waywallen.waywallen.Daemon',
           '-o', '/org/waywallen/waywallen/Daemon', '-m']

def ww(method, *args):
    r = sp.run([*WW_DBUS, f'org.waywallen.waywallen.Daemon1.{method}', *args],
               capture_output=True, text=True, timeout=20)
    return r.returncode == 0

def live_ids(tid):
    try:
        return [e['id'] for e in json.loads(LIVE.read_text()).get(tid, [])]
    except (OSError, ValueError):
        return []

def ww_item(wid):
    """Workshop id -> waywallen katalog id (Steam indirmediyse None)."""
    import sqlite3
    try:
        db = sqlite3.connect(f'file:{WW_DB}?mode=ro', uri=True, timeout=5)
        row = db.execute("SELECT id FROM item WHERE external_id = ? OR path LIKE ? ORDER BY id LIMIT 1",
                         (wid, f'%/431960/{wid}/%')).fetchone()
        db.close()
        return row[0] if row else None
    except sqlite3.Error:
        return None

def live_pick(tid, i):
    """Temanın i'inci sıradan başlayarak indirilmiş ilk hareketli duvarı."""
    ids = live_ids(tid)
    for k in range(len(ids)):
        item = ww_item(ids[(i + k) % len(ids)])
        if item is not None:
            return item
    return None

def live(tid, i):
    """Hareketli duvarı uygular; yoksa waywallen'i gizleyip DMS duvarını bırakır."""
    if not live_ids(tid):
        item = None
    else:
        sp.run(['systemctl', '--user', 'start', 'waywallen.service'], capture_output=True)
        item = live_pick(tid, i)
        if item is None and ww('Rescan'):
            item = live_pick(tid, i)
    if item is None:
        sp.run(['systemctl', '--user', 'stop', 'waywallen-layer-shell.service'], capture_output=True)
        ww('Pause')
        return None
    ww('ApplyById', str(item))
    ww('Resume')
    return item

def pick():
    ts = themes()
    labels = [f"{t['title']}  ({'açık' if t.get('mode') == 'light' else 'koyu'})" for t in ts]
    r = sp.run(['fuzzel', '--dmenu', '-p', 'Tema: '], input='\n'.join(labels), capture_output=True, text=True)
    if r.returncode == 0 and r.stdout.strip() in labels:
        apply(ts[labels.index(r.stdout.strip())]['id'])

def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else 'pick'
    if cmd == 'build':
        build()
    elif cmd == 'pick':
        pick()
    elif cmd == 'apply' and len(sys.argv) > 2:
        apply(sys.argv[2])
    elif cmd == 'wall':
        st = load_state()
        if 'id' in st:
            apply(st['id'], int(sys.argv[2]) if len(sys.argv) > 2 else st.get('wall', 0) + 1)
    elif cmd == 'walls':
        st = load_state()
        t = next((x for x in themes() if x['id'] == st.get('id')), {})
        print(json.dumps([{'index': i, 'path': w, 'active': i == st.get('wall', 0)}
                          for i, w in enumerate(t.get('wallpapers') or [])], ensure_ascii=False))
    elif cmd == 'apps':
        st = load_state()
        render_apps(st['id'], st.get('mode', 'dark'))
    elif cmd == 'live-active':
        # waywallen-layer-shell.service ExecCondition: aktif temada hareketli duvar var mı
        sys.exit(0 if load_state().get('live') else 1)
    elif cmd == 'list':
        print('\n'.join(t['id'] for t in themes()))
    elif cmd == 'json':
        cur = load_state().get('id', '')
        out = []
        for t in themes():
            pal = json.loads((OUT/f"{t['id']}.json").read_text()) if (OUT/f"{t['id']}.json").exists() else {}
            c = pal.get(t.get('mode', 'dark')) or pal.get('dark') or {}
            out.append({'id': t['id'], 'title': t['title'], 'mode': t.get('mode', 'dark'),
                        'active': t['id'] == cur, 'cursor': CURSORS.get(t['id'], ''),
                        'colors': [c.get(k, '#000000') for k in ('surface', 'primary', 'secondary', 'error', 'warning')]})
        print(json.dumps(out, ensure_ascii=False))
    else:
        sys.exit(__doc__)

if __name__ == '__main__':
    main()
