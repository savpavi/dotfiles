#!/usr/bin/env python3
"""dwl-theme: dwl oturumu için tema seçici.

  dwl-theme list          temaları listele (* = etkin)
  dwl-theme current       etkin temanın kimliği
  dwl-theme apply KIMLIK  temayı uygula
  dwl-theme pick          fuzzel ile seç ve uygula
  dwl-theme init          durum dosyaları yoksa etkin (ya da varsayılan) temayı yaz
  dwl-theme wall show|next|off|on|toggle|restart   hareketli duvar kağıdı (waywallen)
                          hareketli duvar kapalıyken statik duvar görünür (temada "wallpapers"
                          ya da ~/.config/dwl-theme/walls.json: {"tema": ["yol", ...]}); "next" onları gezer
  dwl-theme list --json   bar için tema listesi
  dwl-theme host-restore  Qt/KDE/GTK renklerini dwl'den önceki haline döndür (dwl-session çağırır)

Temalar themes/*.json içinde. Uygulanınca ~/.local/state/dwl-theme/ altına
dwl.conf, theme.json, alacritty.toml, ghostty, fuzzel.ini ve dunstrc üretilir; dwl ve bar bu
dosyaları izler, yeniden başlatma gerekmez. Ayrıca Obsidian snippet'i
(<kasa>/.obsidian/snippets/dwl-theme.css, DWL_THEME_OBSIDIAN) ve Vesktop/Vencord temasını
(themes/savpavi.css, dotfiles şablonundan; host yedeğine girer) yazar.
"""
import json
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
THEMES = ROOT / "themes"
STATE = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "dwl-theme"
DEFAULT = "murekkep"


def themes():
    out = {}
    for f in sorted(THEMES.glob("*.json")):
        out[f.stem] = json.loads(f.read_text())
    return out


def current():
    try:
        return (STATE / "current").read_text().strip()
    except OSError:
        return ""


def write(name, text):
    """Atomic replace, so watchers never see a half-written file."""
    tmp = STATE / (name + ".tmp")
    tmp.write_text(text)
    tmp.replace(STATE / name)


def hx(c):
    return c.lstrip("#").lower()


def render(tid, t):
    wm, term, menu, note, bar = t["wm"], t["term"], t["menu"], t["notify"], t["bar"]

    ghostty = [
        f"# {t['name']} — dwl-theme tarafından üretildi, elle düzenleme",
        f"background = {term['bg']}",
        f"foreground = {term['fg']}",
        f"cursor-color = {term['cursor']}",
        f"cursor-text = {term['cursorText']}",
        f"selection-background = {term['selBg']}",
        f"selection-foreground = {term['selFg']}",
        "background-opacity = 1",
        "window-padding-x = 10",
        "window-padding-y = 8",
        "app-notifications = no-clipboard-copy,no-config-reload",
    ] + [f"palette = {i}={c}" for i, c in enumerate(term["palette"])]

    names = ("black", "red", "green", "yellow", "blue", "magenta", "cyan", "white")
    pal = term["palette"]
    alacritty = "\n".join([
        f"# {t['name']} — dwl-theme tarafından üretildi, elle düzenleme",
        "# Yazı tipi, tuşlar vb. kullanıcının kendi ayarından gelir; burada yalnız görünüm ezilir.",
        "[general]",
        'import = ["~/.config/alacritty/alacritty.toml"]',
        "live_config_reload = true",
        "",
        "[window]",
        f"opacity = {term.get('opacity', 1.0)}",
        "blur = false",
        "padding = { x = 10, y = 8 }",
        "",
        "[colors.primary]",
        f'background = "{term["bg"]}"',
        f'foreground = "{term["fg"]}"',
        "",
        "[colors.cursor]",
        f'cursor = "{term["cursor"]}"',
        f'text = "{term["cursorText"]}"',
        "",
        "[colors.selection]",
        f'background = "{term["selBg"]}"',
        f'text = "{term["selFg"]}"',
        "",
        "[colors.normal]",
        *[f'{n} = "{pal[i]}"' for i, n in enumerate(names)],
        "",
        "[colors.bright]",
        *[f'{n} = "{pal[i + 8]}"' for i, n in enumerate(names)],
        "",
    ])

    fuzzel = f"""# {t['name']} — dwl-theme tarafından üretildi, elle düzenleme
[main]
font=JetBrainsMono Nerd Font:size=11
lines=10
width=44
horizontal-pad=14
vertical-pad=10
inner-pad=8
icons-enabled=no
prompt="> "

[colors]
background={hx(menu['bg'])}ff
text={hx(menu['text'])}ff
prompt={hx(menu['match'])}ff
input={hx(menu['text'])}ff
match={hx(menu['match'])}ff
selection={hx(menu['selBg'])}ff
selection-text={hx(menu['selText'])}ff
selection-match={hx(menu['selText'])}ff
border={hx(menu['border'])}ff

[border]
width={menu['borderpx']}
radius={menu['radius']}
"""

    # Bildirimler barın altına/yanına denk gelsin diye küçük bir pay bırakılır.
    dunst = f"""# {t['name']} — dwl-theme tarafından üretildi, elle düzenleme
[global]
    font = JetBrainsMono Nerd Font 10
    width = 360
    offset = (12, 12)
    origin = top-right
    follow = mouse
    frame_width = 2
    frame_color = "{note['frame']}"
    corner_radius = {note['radius']}
    gap_size = 6
    padding = 10
    horizontal_padding = 12
    icon_position = off
    background = "{note['bg']}"
    foreground = "{note['fg']}"
    format = "<b>%s</b>\\n%b"

[urgency_low]
    foreground = "{note['low']}"

[urgency_critical]
    frame_color = "{note['critical']}"
    timeout = 0
"""

    dwl = "".join(f"{k}={wm[k]}\n" for k in ("root", "border", "focus", "urgent", "borderpx", "gap", "anim") if k in wm)
    # scenefx: köşe yarıçapı, gölge ve blur. Temada yoksa 0 yazılır ki önceki temadan kalmasın.
    dwl += "".join(f"{k}={wm.get(k, 0)}\n" for k in ("radius", "shadow", "blur"))
    dwl += f"cursor={t.get('cursor', DEFAULT_CURSOR)}\n"  # dwl imleç temasını canlı değiştirir

    STATE.mkdir(parents=True, exist_ok=True)
    write("ghostty", "\n".join(ghostty) + "\n")
    write("alacritty.toml", alacritty)  # alacritty dosyayı izler, kendiliğinden yeniler
    write("fuzzel.ini", fuzzel)
    write("dunstrc", dunst)
    write("theme.json", json.dumps(dict(t, id=tid), ensure_ascii=False, indent=2) + "\n")
    write("current", tid + "\n")
    # SDDM giriş ekranı da etkin temayı izlesin (sddm/install.sh kurduysa dosya bize ait).
    sddm = Path("/usr/share/sddm/themes/dwl/theme.conf.user")
    if os.access(sddm, os.W_OK):
        sddm.write_text("[General]\n" + "".join(f"{k}={v}\n" for k, v in (
            ("bg", wm["root"]), ("fg", menu["text"]), ("accent", menu["match"]),
            ("border", menu["border"]), ("panel", menu["bg"]),
            ("borderpx", menu["borderpx"]), ("radius", menu["radius"]))))

    write("dwl.conf", dwl)  # en son: dwl bunu görünce yeniden yükler


# --- Uygulama renkleri: Qt (qt6ct/qt5ct), KDE (kdeglobals) ve GTK ---
# Bu dosyalar Hyprland oturumuyla ORTAK (savpavi-shell'in dot-shell-theme'i de aynı yerlere
# yazar). O yüzden ilk yazmadan önce yedeklenir (host_save) ve dwl kapanınca geri konur
# (host_restore; bin/dwl-session çağırır). Böylece Hyprland'e dönünce kendi renkleri durur.
CFG = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
DATA = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share")
HOST = STATE / "host-backup"
DEFAULT_CURSOR = "Nordzy-cursors"
HOST_FILES = [
    CFG / "qt6ct/colors/savpavi.conf", CFG / "qt5ct/colors/savpavi.conf", CFG / "kdeglobals",
    CFG / "gtk-3.0/savpavi-colors.css", CFG / "gtk-4.0/savpavi-colors.css",
    CFG / "gtk-3.0/settings.ini", CFG / "gtk-4.0/settings.ini",
    DATA / "color-schemes/Savpavi.colors",
]


def gsetting(key, value=None):
    cmd = ["gsettings", "get" if value is None else "set", "org.gnome.desktop.interface", key]
    if value is not None:
        cmd.append(value)
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=5).stdout.strip().strip("'")
    except (OSError, subprocess.TimeoutExpired):
        return ""


def kde_notify():
    quiet("dbus-send", "--type=signal", "/KGlobalSettings",
          "org.kde.KGlobalSettings.notifyChange", "int32:0", "int32:0")


def host_save():
    """Ortak dosyaların dwl'den önceki halini bir kez saklar (yedek varsa dokunmaz)."""
    import shutil
    if (HOST / "manifest.json").exists():
        return
    HOST.mkdir(parents=True, exist_ok=True)
    saved = {}
    for i, f in enumerate(HOST_FILES):
        if f.exists():
            shutil.copy2(f, HOST / f"{i}.bak")
            saved[str(f)] = f"{i}.bak"
        else:
            saved[str(f)] = None
    (HOST / "manifest.json").write_text(json.dumps(
        {"files": saved, "color-scheme": gsetting("color-scheme"),
         "cursor-theme": gsetting("cursor-theme")}, indent=1))


def host_keep(key):
    """Yedek, bu ayar eklenmeden önce alındıysa ayarın ilk halini sonradan ekler."""
    man = HOST / "manifest.json"
    try:
        m = json.loads(man.read_text())
    except (OSError, ValueError):
        return
    if key not in m:
        m[key] = gsetting(key)
        man.write_text(json.dumps(m, indent=1))


def host_keep_file(f):
    """Yedek bu dosya listeye girmeden önce alındıysa dosyanın dwl öncesi halini ekler."""
    import shutil
    man = HOST / "manifest.json"
    try:
        m = json.loads(man.read_text())
    except (OSError, ValueError):
        host_save()
        return
    if str(f) in m["files"]:
        return
    bak = None
    if f.exists():
        bak = f"extra-{len(m['files'])}.bak"
        shutil.copy2(f, HOST / bak)
    m["files"][str(f)] = bak
    man.write_text(json.dumps(m, indent=1))


def host_restore():
    """dwl'den önceki uygulama renklerini geri koyar ve yedeği siler."""
    import shutil
    man = HOST / "manifest.json"
    if not man.exists():
        return
    m = json.loads(man.read_text())
    for f, bak in m["files"].items():
        if bak and (HOST / bak).exists():
            shutil.copy2(HOST / bak, f)
        elif bak is None:
            Path(f).unlink(missing_ok=True)
    if m.get("color-scheme"):
        gsetting("color-scheme", m["color-scheme"])
    if m.get("cursor-theme"):
        gsetting("cursor-theme", m["cursor-theme"])
    kde_notify()
    shutil.rmtree(HOST, ignore_errors=True)


def rgb(c):
    c = c.lstrip("#")
    return tuple(int(c[i:i + 2], 16) for i in (0, 2, 4))


def mix(a, b, t):
    ra, rb = rgb(a), rgb(b)
    return "#%02x%02x%02x" % tuple(round(x + (y - x) * t) for x, y in zip(ra, rb))


def render_apps(t):
    term, menu, bar = t["term"], t["menu"], t["bar"]
    bg, view, fg = menu["bg"], term["bg"], menu["text"]
    accent, on_accent = bar["accent"], bar["onAccent"]
    pal = term["palette"]
    dark = sum(rgb(bg)) < 3 * 128
    faded = mix(fg, bg, 0.45)
    raised = mix(bg, fg, 0.06)
    alt = mix(view, fg, 0.04)

    # QPalette sırası: WindowText Button Light Midlight Dark Mid Text BrightText ButtonText Base
    # Window Shadow Highlight HighlightedText Link LinkVisited AlternateBase NoRole ToolTipBase
    # ToolTipText PlaceholderText
    def roles(text, hl, hl_text):
        return ", ".join([text, raised, mix(bg, fg, 0.18), mix(bg, fg, 0.10), mix(bg, "#000000", 0.35),
                          mix(bg, fg, 0.25), text, text, text, view, bg, "#000000", hl, hl_text,
                          pal[4], pal[5], alt, bg, bg, text, faded])

    def tri(c):
        return ",".join(str(x) for x in rgb(c))

    def group(name, back, back_alt, text, text_active=None):
        return f"""[Colors:{name}]
BackgroundAlternate={tri(back_alt)}
BackgroundNormal={tri(back)}
DecorationFocus={tri(accent)}
DecorationHover={tri(accent)}
ForegroundActive={tri(text_active or accent)}
ForegroundInactive={tri(faded)}
ForegroundLink={tri(pal[4])}
ForegroundNegative={tri(pal[1])}
ForegroundNeutral={tri(pal[3])}
ForegroundNormal={tri(text)}
ForegroundPositive={tri(pal[2])}
ForegroundVisited={tri(pal[5])}
"""

    kde = "\n".join([
        f"""[ColorEffects:Disabled]
Color={tri(faded)}
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color={tri(mix(bg, fg, 0.4))}
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0
""",
        group("Button", raised, mix(raised, fg, 0.04), fg),
        group("Complementary", raised, bg, fg),
        group("Header", bg, bg, fg),
        group("Header][Inactive", bg, bg, fg),
        group("Selection", accent, mix(accent, bg, 0.4), on_accent, on_accent),
        group("Tooltip", bg, bg, fg),
        group("View", view, alt, fg),
        group("Window", bg, bg, fg),
        f"""[WM]
activeBackground={tri(bg)}
activeBlend={tri(fg)}
activeForeground={tri(fg)}
inactiveBackground={tri(bg)}
inactiveBlend={tri(faded)}
inactiveForeground={tri(faded)}
"""])

    qt = f"""[ColorScheme]
active_colors={roles(fg, accent, on_accent)}
disabled_colors={roles(faded, mix(accent, bg, 0.5), faded)}
inactive_colors={roles(fg, accent, on_accent)}

""" + kde

    scheme = f"[General]\nColorScheme=Savpavi\nName=Savpavi\n\n" + kde

    gtk = f"""/* {t['name']} — dwl-theme tarafından üretildi */
@define-color destructive_bg_color {pal[1]};
@define-color destructive_fg_color #ffffff;
@define-color error_bg_color {pal[1]};
@define-color error_fg_color #ffffff;
@define-color accent_fg_color {on_accent};
@define-color accent_bg_color {accent};
@define-color accent_color {accent};
@define-color window_bg_color {bg};
@define-color window_fg_color {fg};
@define-color view_bg_color {view};
@define-color view_fg_color {fg};
@define-color headerbar_bg_color {bg};
@define-color headerbar_fg_color {fg};
@define-color sidebar_bg_color {raised};
@define-color sidebar_fg_color {fg};
@define-color secondary_sidebar_bg_color {bg};
@define-color secondary_sidebar_fg_color {fg};
@define-color card_bg_color {raised};
@define-color card_fg_color {fg};
@define-color overview_bg_color {raised};
@define-color overview_fg_color {fg};
@define-color popover_bg_color {raised};
@define-color popover_fg_color {fg};
@define-color dialog_bg_color {bg};
@define-color dialog_fg_color {fg};
@define-color headerbar_backdrop_color @window_bg_color;
@define-color sidebar_backdrop_color @sidebar_bg_color;
@define-color theme_unfocused_fg_color @window_fg_color;
@define-color theme_unfocused_text_color @view_fg_color;
@define-color theme_unfocused_bg_color @window_bg_color;
@define-color theme_unfocused_base_color @window_bg_color;
@define-color theme_unfocused_selected_bg_color @accent_bg_color;
@define-color theme_unfocused_selected_fg_color @accent_fg_color;
"""

    host_save()
    for f, text in ((CFG / "qt6ct/colors/savpavi.conf", qt), (CFG / "qt5ct/colors/savpavi.conf", qt),
                    (DATA / "color-schemes/Savpavi.colors", scheme),
                    (CFG / "gtk-3.0/savpavi-colors.css", gtk), (CFG / "gtk-4.0/savpavi-colors.css", gtk)):
        if f.parent.is_dir():
            f.write_text(text)

    # kdeglobals: yalnız renk gruplarını değiştir, gerisine dokunma
    import configparser

    def load(text=None, path=None):
        c = configparser.RawConfigParser(delimiters=("=",), strict=False, interpolation=None)
        c.optionxform = str
        if text is not None:
            c.read_string(text)
        elif path.exists():
            c.read(path, encoding="utf-8")
        return c

    target = CFG / "kdeglobals"
    src, dst = load(text=kde), load(path=target)
    for g in src.sections():
        if dst.has_section(g):
            dst.remove_section(g)
        dst.add_section(g)
        for k, v in src.items(g):
            dst.set(g, k, v)
    for sec in ("General", "UiSettings"):
        if not dst.has_section(sec):
            dst.add_section(sec)
        dst.set(sec, "ColorScheme", "Savpavi")
    dst.remove_option("General", "ColorSchemeHash")
    with target.open("w", encoding="utf-8") as f:
        dst.write(f, space_around_delimiters=False)

    # GTK açık/koyu tercihi ve imleç (cursor-shape desteklemeyen GTK3/Xwayland uygulamaları için)
    cur = t.get("cursor", DEFAULT_CURSOR)
    for ini in (CFG / "gtk-3.0/settings.ini", CFG / "gtk-4.0/settings.ini"):
        if ini.exists():
            lines = [l for l in ini.read_text().splitlines()
                     if not l.startswith(("gtk-application-prefer-dark-theme", "gtk-cursor-theme-name"))]
            lines.append("gtk-application-prefer-dark-theme=" + ("true" if dark else "false"))
            lines.append("gtk-cursor-theme-name=" + cur)
            ini.write_text("\n".join(lines) + "\n")
    gsetting("color-scheme", "prefer-dark" if dark else "prefer-light")
    host_keep("cursor-theme")
    gsetting("cursor-theme", cur)
    os.environ["XCURSOR_THEME"] = cur
    quiet("dbus-update-activation-environment", "--systemd", "XCURSOR_THEME")
    # Açık Qt uygulamaları: qt6ct yalnız kendi ayar dosyasını izler; zaman damgasını
    # güncellemek paleti yeniden okutur. KDE uygulamaları için ayrıca sinyal.
    for conf in (CFG / "qt6ct/qt6ct.conf", CFG / "qt5ct/qt5ct.conf"):
        if conf.exists():
            os.utime(conf)
    kde_notify()


# --- Obsidian ve Discord: tema değişince CSS'i yeniden yaz; ikisi de dosyayı izleyip canlı yeniler ---
OBSIDIAN_VAULTS = [Path(p).expanduser() for p in os.environ.get(
    "DWL_THEME_OBSIDIAN", "~/Documents/Obsidian/Aktif Kasa").split(":") if p]
# Discord CSS'i Vencord/Vesktop üzerinden alır. Hyprland'deki dot-shell-theme de aynı
# savpavi.css'i yazar (aynı şablonla); dwl'nin yazdığı host yedeğine girer, dwl kapanınca geri gelir.
DISCORD_THEME_FILES = [Path.home() / ".config" / d / "themes/savpavi.css" for d in ("vesktop", "Vencord")]
DISCORD_TEMPLATE = Path.home() / "dotfiles/templates/apps/vesktop.css"


def app_palette(t):
    term, bar, menu = t["term"], t["bar"], t["menu"]
    bg, fg = term["bg"], term["fg"]
    pal = term["palette"]
    return dict(
        bg=bg, bg2=menu["bg"], bg3=mix(menu["bg"], "#000000", 0.25), raised=mix(bg, fg, 0.06),
        hover=mix(bg, fg, 0.10), border=mix(bg, fg, 0.18), fg=fg, muted=mix(fg, bg, 0.35),
        faint=mix(fg, bg, 0.55), accent=bar["accent"], on_accent=bar["onAccent"],
        accent2=mix(bar["accent"], fg, 0.25), urgent=bar["urgent"], sel=term["selBg"],
        red=pal[1], green=pal[2], yellow=pal[3], blue=pal[4], magenta=pal[5], cyan=pal[6],
        dark=sum(rgb(bg)) < 3 * 128)


def render_obsidian(t, name):
    c = app_palette(t)
    body = f"""  --background-primary: {c['bg']}; --background-primary-alt: {c['raised']};
  --background-secondary: {c['bg2']}; --background-secondary-alt: {c['bg3']};
  --background-modifier-border: {c['border']}; --background-modifier-border-hover: {c['hover']};
  --background-modifier-hover: {c['hover']}; --background-modifier-active-hover: {c['hover']};
  --background-modifier-form-field: {c['raised']};
  --titlebar-background: {c['bg3']}; --titlebar-background-focused: {c['bg3']};
  --ribbon-background: {c['bg3']}; --tab-container-background: {c['bg2']};
  --text-normal: {c['fg']}; --text-muted: {c['muted']}; --text-faint: {c['faint']};
  --text-accent: {c['accent']}; --text-accent-hover: {c['accent2']}; --text-on-accent: {c['on_accent']};
  --text-selection: {mix(c['sel'], c['bg'], 0.55)}; --text-highlight-bg: {mix(c['yellow'], c['bg'], 0.6)};
  --interactive-accent: {c['accent']}; --interactive-accent-hover: {c['accent2']};
  --interactive-normal: {c['raised']}; --interactive-hover: {c['hover']};
  --color-accent: {c['accent']}; --color-accent-1: {c['accent2']}; --color-accent-2: {c['accent2']};
  --link-color: {c['accent']}; --link-external-color: {c['cyan']}; --link-unresolved-color: {c['muted']};
  --h1-color: {c['fg']}; --h2-color: {c['accent']}; --h3-color: {c['accent2']};
  --h4-color: {c['muted']}; --h5-color: {c['muted']}; --h6-color: {c['faint']};
  --tag-color: {c['accent']}; --tag-background: {mix(c['accent'], c['bg'], 0.85)};
  --checkbox-color: {c['accent']}; --checkbox-marker-color: {c['on_accent']};
  --blockquote-border-color: {c['accent']}; --hr-color: {c['border']};
  --code-background: {c['raised']}; --code-normal: {c['fg']}; --code-comment: {c['faint']};
  --code-keyword: {c['magenta']}; --code-string: {c['green']}; --code-function: {c['blue']};
  --code-value: {c['yellow']}; --code-property: {c['cyan']}; --code-tag: {c['red']};
  --code-operator: {c['muted']}; --code-punctuation: {c['muted']};
  --color-red: {c['red']}; --color-green: {c['green']}; --color-yellow: {c['yellow']};
  --color-blue: {c['blue']}; --color-purple: {c['magenta']}; --color-cyan: {c['cyan']};
  --graph-node: {c['muted']}; --graph-node-focused: {c['accent']}; --graph-line: {c['border']};"""
    css = (f"/* dwl-theme: {name}. Elle düzenleme; tema değişince yeniden yazılır. */\n"
           f"body.theme-dark:not(.is-mobile), body.theme-light:not(.is-mobile) {{\n{body}\n}}\n")
    for vault in OBSIDIAN_VAULTS:
        d = vault / ".obsidian/snippets"
        if not d.is_dir():
            continue
        f = d / "dwl-theme.css"
        tmp = d / ".dwl-theme.css.tmp"
        tmp.write_text(css)
        tmp.replace(f)
        # snippet'i bir kez etkinleştir (Obsidian açıkken de appearance.json değişikliğini okur)
        ap = vault / ".obsidian/appearance.json"
        try:
            conf = json.loads(ap.read_text())
            on = conf.setdefault("enabledCssSnippets", [])
            if "dwl-theme" not in on:
                on.append("dwl-theme")
                ap.write_text(json.dumps(conf, indent=2) + "\n")
        except (OSError, ValueError):
            pass


def render_discord(t, name):
    """dotfiles'taki DMS/matugen şablonunu dwl paletiyle doldurur."""
    if not DISCORD_TEMPLATE.exists():
        return
    c, pal = app_palette(t), t["term"]["palette"]
    s, fg = c["bg"], c["fg"]
    roles = {
        "surface": s, "background": s, "on_surface": fg, "on_background": fg,
        "surface_variant": c["raised"], "on_surface_variant": c["muted"],
        "surface_container_lowest": c["bg3"], "surface_container_low": mix(s, fg, 0.03),
        "surface_container": c["bg2"], "surface_container_high": mix(s, fg, 0.08),
        "surface_container_highest": mix(s, fg, 0.12),
        "outline": mix(c["muted"], s, 0.45), "outline_variant": c["border"],
        "primary": c["accent"], "on_primary": c["on_accent"],
        "secondary": pal[4], "on_secondary": s, "tertiary": pal[5], "on_tertiary": s,
        "error": c["urgent"], "on_error": s,
    }
    for k in ("primary", "secondary", "tertiary", "error"):
        roles[k + "_container"] = mix(roles[k], s, 0.6)
        roles["on_" + k + "_container"] = fg

    def sub(m):
        h = roles.get(m.group(1), c["accent"]).lstrip("#").lower()
        f = m.group(2)
        if f == "hex":
            return "#" + h
        if f == "hex_stripped":
            return h
        return str(int(h[{"red": 0, "green": 2, "blue": 4}[f]:][:2], 16))

    import re
    css = re.sub(r"\{\{\s*colors\.(\w+)\.\w+\.(hex_stripped|hex|red|green|blue)\s*\}\}", sub,
                 DISCORD_TEMPLATE.read_text())
    for f in DISCORD_THEME_FILES:
        if f.parent.is_dir():
            host_keep_file(f)
            tmp = f.with_name("." + f.name + ".tmp")
            tmp.write_text(css)
            tmp.replace(f)


def quiet(*cmd):
    try:
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        pass


def apply(tid, live=True):
    all_ = themes()
    if tid not in all_:
        sys.exit(f"dwl-theme: böyle bir tema yok: {tid} (var olanlar: {', '.join(all_)})")
    render(tid, all_[tid])
    # DWL_NESTED: deneme oturumu; gerçek oturumun dunst'ına, terminallerine, duvarına dokunma
    if live and not os.environ.get("DWL_NESTED"):
        # Yalnız bu temayla başlatılmış süreçlere dokun; başka oturumun
        # terminallerini ve bildirim servisini rahat bırak.
        if subprocess.run(["pgrep", "-f", "dunst -conf .*dwl-theme/dunstrc"],
                          stdout=subprocess.DEVNULL).returncode == 0:
            quiet("dunstctl", "reload", str(STATE / "dunstrc"))
        quiet("pkill", "-USR2", "-f", "^ghostty .*dwl-theme/ghostty")
        render_apps(all_[tid])
        name = all_[tid].get("name", tid)
        for fn in (render_obsidian, render_discord):
            try:
                fn(all_[tid], name)
            except OSError as e:
                print(f"dwl-theme: {fn.__name__}: {e}", file=sys.stderr)
        wall_async()


# --- Hareketli duvar kağıdı: waywallen (Flatpak daemon) + waywallen-layer-shell ---
# Temanın "live" listesi Wallpaper Engine Workshop kimlikleridir.
WW_DB = Path.home() / ".var/app/org.waywallen.waywallen/data/waywallen/waywallen-v2.db"
WW_SHELL = Path.home() / ".local/bin/waywallen-layer-shell"
WW_SOCK = Path(os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())) / "waywallen/display.sock"


def ww(method, *args):
    try:
        r = subprocess.run(["gdbus", "call", "--session", "-d", "org.waywallen.waywallen.Daemon",
                            "-o", "/org/waywallen/waywallen/Daemon",
                            "-m", f"org.waywallen.waywallen.Daemon1.{method}", *args],
                           capture_output=True, text=True, timeout=20)
        return r.returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def ww_item(wid):
    """Workshop kimliği -> waywallen katalog kimliği (indirilmemişse None)."""
    import sqlite3
    try:
        db = sqlite3.connect(f"file:{WW_DB}?mode=ro", uri=True, timeout=5)
        row = db.execute("SELECT id FROM item WHERE external_id = ? OR path LIKE ? ORDER BY id LIMIT 1",
                         (str(wid), f"%/431960/{wid}/%")).fetchone()
        db.close()
        return row[0] if row else None
    except sqlite3.Error:
        return None


def wall_state():
    try:
        return json.loads((STATE / "wall.json").read_text())
    except (OSError, ValueError):
        return {}


def wall_running():
    return subprocess.run(["pgrep", "-f", "^" + str(WW_SHELL) + "$"],
                          stdout=subprocess.DEVNULL).returncode == 0


def wall_stop():
    quiet("pkill", "-f", "^" + str(WW_SHELL) + "$")
    ww("Pause")


def wall_show():
    """Etkin temanın seçili hareketli duvarını gösterir; yoksa katmanı kapatır."""
    import time
    if os.environ.get("DWL_THEME_NO_WALL"):  # iç içe deneme oturumları gerçek duvara dokunmasın
        return
    st = wall_state()
    tid = current()
    ids = themes().get(tid, {}).get("live", [])
    if st.get("off") or not ids or not WW_SHELL.exists():
        wall_stop()
        return
    quiet("systemctl", "--user", "start", "waywallen.service")
    start = st.get("index", {}).get(tid, 0)
    item = None
    for k in range(len(ids)):
        item = ww_item(ids[(start + k) % len(ids)])
        if item is not None:
            break
    if item is None:
        wall_stop()
        return
    fresh = not wall_running()
    if fresh:
        for _ in range(50):
            if WW_SOCK.exists():
                break
            time.sleep(0.2)
        subprocess.Popen([str(WW_SHELL)], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        # Katman yeni bağlanınca waywallen son duvarı geri çağırıp seçimi eziyor.
        time.sleep(2.5)
    ww("ApplyById", str(item))
    ww("Resume")


def wall_async():
    """Tema değişimini bekletmemek için duvar işini arka plana atar."""
    subprocess.Popen([sys.executable, __file__, "wall", "show"], stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


WALLS = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "dwl-theme/walls.json"


def static_walls(tid, theme):
    """Temanın statik duvarları: temadaki "wallpapers", yoksa kişisel walls.json (repo dışı)."""
    walls = theme.get("wallpapers")
    if not walls:
        try:
            walls = json.loads(WALLS.read_text()).get(tid)
        except (OSError, ValueError, AttributeError):
            walls = None
    return [str(Path(w).expanduser()) for w in walls or [] if Path(w).expanduser().is_file()]


def wall(cmd):
    st = wall_state()
    tid = current()
    theme = themes().get(tid, {})
    n = len(theme.get("live", []))
    statics = static_walls(tid, theme)
    if cmd == "next" and statics and (st.get("off") or not n):
        # hareketli duvar kapalıyken "sonraki" statik duvarları gezer
        idx = st.setdefault("static", {})
        idx[tid] = (idx.get(tid, 0) + 1) % len(statics)
    elif cmd == "next" and n:
        idx = st.setdefault("index", {})
        idx[tid] = (idx.get(tid, 0) + 1) % n
        st["off"] = False
    elif cmd == "off":
        st["off"] = True
    elif cmd == "on":
        st["off"] = False
    elif cmd == "toggle":
        st["off"] = not st.get("off", False)
    elif cmd == "restart":
        # Ekranlar kapanıp açılınca katman bazı ekranlarda geri gelmiyor; baştan başlat.
        import time
        quiet("pkill", "-f", "^" + str(WW_SHELL) + "$")
        time.sleep(0.6)
    elif cmd != "show":
        sys.exit(__doc__)
    # Bar bu yolu arka plana çizer; hareketli duvar açıkken boş kalır ki onu örtmesin.
    live_on = bool(n) and not st.get("off") and WW_SHELL.exists()
    st["image"] = "" if live_on or not statics else statics[st.get("static", {}).get(tid, 0) % len(statics)]
    STATE.mkdir(parents=True, exist_ok=True)
    write("wall.json", json.dumps(st) + "\n")
    wall_show()


def pick():
    all_ = themes()
    cur = current()
    ids = list(all_)
    lines = "\n".join(all_[i]["name"] + ("  (etkin)" if i == cur else "") for i in ids)
    cfg = STATE / "fuzzel.ini"
    cmd = ["fuzzel", "--dmenu", "--index", "--prompt", "tema > ", "--lines", str(len(ids))]
    if cfg.exists():
        cmd.append(f"--config={cfg}")
    r = subprocess.run(cmd, input=lines, capture_output=True, text=True)
    if r.returncode == 0 and r.stdout.strip().isdigit():
        apply(ids[int(r.stdout.strip())])


def main():
    a = sys.argv[1:]
    if a == ["list"]:
        cur = current()
        for i, t in themes().items():
            print(("* " if i == cur else "  ") + f"{i:10} {t['name']}")
    elif a == ["list", "--json"]:
        cur = current()
        st = wall_state()
        print(json.dumps({
            "current": cur,
            "wallOff": bool(st.get("off")),
            "themes": [{"id": i, "name": t["name"], "active": i == cur,
                        "accent": t["bar"]["accent"], "bg": t["wm"]["root"],
                        "walls": len(t.get("live", []))} for i, t in themes().items()],
        }, ensure_ascii=False))
    elif len(a) == 2 and a[0] == "wall":
        wall(a[1])
    elif a == ["host-save"]:
        host_save()
    elif a == ["host-restore"]:
        host_restore()
    elif a == ["current"]:
        print(current())
    elif len(a) == 2 and a[0] == "apply":
        apply(a[1])
    elif a == ["pick"]:
        pick()
    elif a == ["init"]:
        cur = current()
        if not (STATE / "dwl.conf").exists() or cur not in themes():
            apply(cur if cur in themes() else DEFAULT, live=False)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
