#!/usr/bin/env python3
"""Brave ile web uygulaması başlatıcısı oluştur: dot-webapp İsim https://adres"""
import argparse
import re
from pathlib import Path
from urllib.parse import urlsplit

p = argparse.ArgumentParser(description=__doc__)
p.add_argument('name')
p.add_argument('url')
p.add_argument('--directory', type=Path, default=Path.home()/'.local/share/applications')
a = p.parse_args()
if any(ord(c)<32 for c in a.name+a.url): p.error('Kontrol karakteri kullanılamaz')
u = urlsplit(a.url)
if u.scheme not in ('https', 'http') or not u.hostname or u.username or u.password:
    p.error('Geçerli bir http/https adresi gerekli')
slug = re.sub('[^a-z0-9]+', '-', a.name.lower()).strip('-')
if not slug: p.error('İsim en az bir ASCII harf veya rakam içermeli')
def quote(value):
    # Desktop Entry string escapes are decoded before Exec argument escapes.
    escaped = ''.join('\\'+c if c in '\\"`$' else c for c in value).replace('%', '%%')
    return '"'+escaped.replace('\\', '\\\\')+'"'
a.directory.mkdir(parents=True, exist_ok=True)
path = a.directory/f'webapp-{slug}.desktop'
try:
    with path.open('x') as f:
        f.write('[Desktop Entry]\nType=Application\nVersion=1.0\n')
        f.write('Name='+a.name.replace('\\', '\\\\')+'\n')
        f.write('Exec=brave-origin '+quote('--app='+a.url)+'\n')
        f.write('Icon=brave-browser\nTerminal=false\nCategories=Network;\n')
        f.write('StartupNotify=true\n')
except FileExistsError:
    p.error('Başlatıcı zaten var; üzerine yazılmadı: '+str(path))
print(path)
