#!/usr/bin/env python3
"""dwl-keys: config.h'deki kısayolları okuyup temalı fuzzel'de aranabilir listeler.

Liste her seferinde config.h'den üretilir, bu yüzden elle güncellemek gerekmez.
  dwl-keys          listeyi göster
  dwl-keys --print  yalnız yazdır
"""
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
STATE = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "dwl-theme"

MODS = {"MODKEY": "Super", "WLR_MODIFIER_SHIFT": "Shift", "WLR_MODIFIER_CTRL": "Ctrl",
        "WLR_MODIFIER_ALT": "Alt", "WLR_MODIFIER_LOGO": "Super", "0": ""}
KEYS = {"Return": "Enter", "space": "Space", "comma": ",", "period": ".", "Escape": "Esc",
        "Left": "←", "Right": "→", "Up": "↑", "Down": "↓",
        "XF86AudioRaiseVolume": "Ses+", "XF86AudioLowerVolume": "Ses-", "XF86AudioMute": "Sessiz",
        "XF86AudioPlay": "Oynat", "XF86AudioPause": "Duraklat",
        "XF86AudioNext": "Sonraki", "XF86AudioPrev": "Önceki"}

# işlev (ve gerekirse argüman) -> açıklama
FUNCS = {
    "killclient": "Pencereyi kapat",
    "zoom": "Pencereyi ana alana al",
    "togglefloating": "Pencereyi serbest/döşeli yap",
    "togglefullscreen": "Tam ekran",
    "quit": "dwl'den çık (oturumu kapat)",
    "focusmon": "Diğer ekrana odaklan",
    "tagmon": "Pencereyi diğer ekrana taşı",
}
SPAWN = [  # komutta geçen parça -> açıklama (ilk eşleşen)
    ("termcmd", "Terminal (Alacritty)"), ("menucmd", "Uygulama başlatıcı"),
    ("dwl-grab --clip", "İndir: panodaki link (yt-dlp / gallery-dl)"),
    ("dwl-grab", "İndir: tarayıcı sekmesi ya da panodaki link"),
    ("dwl-theme pick", "Tema seç"), ("dwl-clip", "Pano geçmişi"), ("dwl-keys", "Bu kısayol listesi"),
    ("dwl-shot region", "Ekran görüntüsü: alan"), ("dwl-shot edit", "Ekran görüntüsü: alan + düzenle"),
    ("dwl-shot screen", "Ekran görüntüsü: tüm ekran"),
    ("call lock", "Ekranı kilitle"), ("toggle power", "Güç menüsü"),
    ("toggle notif", "Bildirim merkezi"), ("toggle theme", "Tema paneli"),
    ("claude-desktop", "Claude Desktop"),
    ("dolphin", "Dosya yöneticisi (Dolphin)"), ("brave", "Tarayıcı (Brave Origin)"),
    ("looking-glass", "Windows VM (Looking Glass)"), ("spotify", "Spotify"),
    ("Telegram", "Telegram"), ("discord", "Discord"), ("zed", "Zed editör"), ("obsidian", "Obsidian"),
    ("set-volume", "Ses seviyesi"), ("set-mute", "Sesi kapat/aç"),
    ("play-pause", "Oynat/duraklat"), ("playerctl next", "Sonraki parça"),
    ("playerctl previous", "Önceki parça"), ("grim", "Ekran görüntüsü"),
]


def combo(mods, key):
    parts = [MODS.get(m.strip(), m.strip()) for m in mods.split("|")]
    key = key.replace("XKB_KEY_", "")
    key = KEYS.get(key, key.upper() if len(key) == 1 else key)
    return "+".join([p for p in parts if p] + [key])


def describe(func, arg):
    if func == "spawn":
        for needle, text in SPAWN:
            if needle in arg:
                return text
        m = re.search(r'SHCMD\("(.*)"\)', arg)
        return "Çalıştır: " + (m.group(1) if m else arg)
    if func == "focusstack":
        return "Odak: sonraki pencere" if "+1" in arg else "Odak: önceki pencere"
    if func == "setmfact":
        return "Ana alanı genişlet" if "+" in arg else "Ana alanı daralt"
    if func == "incnmaster":
        return "Ana alana pencere ekle" if "+1" in arg else "Ana alandan pencere çıkar"
    if func == "setlayout":
        return {"layouts[0]": "Düzen: döşeme", "layouts[1]": "Düzen: serbest",
                "layouts[2]": "Düzen: tek pencere (monocle)"}.get(
                    next((k for k in ("layouts[0]", "layouts[1]", "layouts[2]") if k in arg), ""),
                    "Düzeni değiştir")
    if func == "view":
        return "Tüm tag'leri göster" if "~0" in arg else "Önceki tag'e dön"
    if func == "tag":
        return "Pencereyi tüm tag'lere koy"
    return FUNCS.get(func, func)


def rows():
    src = (ROOT / "config.h").read_text()
    body = src[src.index("static const Key keys[]"):]
    body = body[:body.index("\n};")]
    out = []
    pat = re.compile(r"\{\s*([^,{}]+?),\s*(XKB_KEY_\w+),\s*(\w+),\s*(.*)\}\s*,\s*$")
    for line in body.splitlines():
        m = pat.match(line.strip())
        if not m or m.group(3) == "chvt":
            continue
        mods, key, func, arg = m.groups()
        out.append((combo(mods, key), describe(func, arg)))
    out += [("Sol Shift+Sağ Shift", "Klavye düzeni: tr / us"),
            ("Super+1..9", "Tag'e geç"), ("Super+Shift+1..9", "Pencereyi tag'e taşı"),
            ("Super+Ctrl+1..9", "Tag'i görünüme ekle/çıkar"),
            ("Super+sol tık", "Pencereyi taşı"), ("Super+sağ tık", "Pencereyi boyutlandır"),
            ("Super+tekerlek", "Pencereler arasında gez")]
    return out


def main():
    r = rows()
    w = max(len(k) for k, _ in r)
    text = "\n".join(f"{k:<{w}}   {d}" for k, d in r)
    if sys.argv[1:] == ["--print"]:
        print(text)
        return
    cmd = ["fuzzel", "--dmenu", "--prompt", "kısayol > ", "--width", "64", "--lines", "18"]
    cfg = STATE / "fuzzel.ini"
    if cfg.exists():
        cmd.append(f"--config={cfg}")
    subprocess.run(cmd, input=text, text=True, stdout=subprocess.DEVNULL)


if __name__ == "__main__":
    main()
