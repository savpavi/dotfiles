{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "/home/savpavi/.config/noctalia/assets/eb-logo-nord.png",
    "width": 24,
    "height": 12,
    "padding": {
      "top": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "",
    "size": {
      "ndigits": 1
    }
  },
  "modules": [
    { "type": "custom", "key": "╭──────────────╮", "keyColor": "yellow", "format": "" },
    { "type": "os", "key": "│ 󰣇  Dağıtım   │ ", "keyColor": "yellow", "format": "{name} {version-id} {arch}" },
    { "type": "command", "key": "│ 󰧨  Oturum    │ ", "keyColor": "magenta", "text": "printf '%s' \"${XDG_CURRENT_DESKTOP:-N/A}\"" },
    { "type": "wm", "key": "│   WM        │ ", "keyColor": "yellow" },
    { "type": "lm", "key": "│ 󰧨  LM        │ ", "keyColor": "yellow" },
    { "type": "kernel", "key": "│   Çekirdek  │ ", "keyColor": "yellow", "format": "{sysname} {release}" },
    { "type": "bootmgr", "key": "│ 󰘳  BootMgr   │ ", "keyColor": "yellow" },
    { "type": "terminal", "key": "│   Terminal  │ ", "keyColor": "yellow" },
    { "type": "terminalfont", "key": "│   TermFont  │ ", "keyColor": "yellow" },
    { "type": "shell", "key": "│   Kabuk     │ ", "keyColor": "yellow" },
    { "type": "packages", "key": "│ 󰏖  Paketler  │ ", "keyColor": "yellow" },
    { "type": "uptime", "key": "│ 󰅐  Açık      │ ", "keyColor": "yellow" },
    {
      "type": "command",
      "key": "│ 󰍹  VM        │ ",
      "keyColor": "cyan",
      "text": "state=$(LC_ALL=C timeout 2s virsh -c qemu:///system domstate EGE-Windows11 2>/dev/null) || { printf 'Bilinmiyor'; exit 0; }; case \"$state\" in running) printf 'Açık';; \"shut off\") printf 'Kapalı';; paused) printf 'Duraklatılmış';; pmsuspended) printf 'Askıda';; *) printf 'Bilinmiyor';; esac"
    },
    {
      "type": "command",
      "key": "│ 󰙅  Syncthing │ ",
      "keyColor": "cyan",
      "text": "state=$(LC_ALL=C timeout 2s systemctl --user is-active syncthing.service 2>/dev/null); case \"$state\" in active) printf 'Çalışıyor';; inactive) printf 'Kapalı';; failed) printf 'Hata';; activating) printf 'Başlatılıyor';; deactivating) printf 'Durduruluyor';; *) printf 'Bilinmiyor';; esac"
    },
    {
      "type": "command",
      "key": "│ 󰖟  Tailscale │ ",
      "keyColor": "cyan",
      "text": "timeout 2s tailscale status --json 2>/dev/null | python3 -c 'import json,sys\ntry:\n d=json.load(sys.stdin); s=d.get(\"BackendState\"); print({\"Running\":\"Çalışıyor\", \"Stopped\":\"VPN kapalı\", \"NeedsLogin\":\"Oturum gerekli\", \"Starting\":\"Başlatılıyor\", \"NeedsMachineAuth\":\"Onay gerekli\"}.get(s,\"Bilinmiyor\"))\nexcept Exception:\n print(\"Bilinmiyor\")'"
    },
    { "type": "custom", "key": "├──────────────┤", "keyColor": "yellow", "format": "" },
    { "type": "bios", "key": "│ 󰍛  BIOS      │ ", "keyColor": "yellow" },
    { "type": "cpu", "key": "│   CPU       │ ", "keyColor": "yellow" },
    { "type": "cpuusage", "key": "│ 󰓅  CPU Use   │ ", "keyColor": "yellow" },
    { "type": "gpu", "key": "│ 󰢮  GPU       │ ", "keyColor": "yellow" },
    { "type": "vulkan", "key": "│   Vulkan    │ ", "keyColor": "yellow" },
    {
      "type": "display",
      "key": "│ 󰍹  Monitör   │ ",
      "keyColor": "yellow",
      "format": "{width}x{height}{?refresh-rate} @ {refresh-rate} Hz{?}{?physical-width} - {physical-width}x{physical-height} mm ({inch} inç, {ppi} ppi){?}"
    },
    { "type": "memory", "key": "│ 󰘚  Bellek    │ ", "keyColor": "yellow" },
    { "type": "swap", "key": "│ 󰓡  Swap      │ ", "keyColor": "yellow" },
    { "type": "custom", "key": "├──────────────┤", "keyColor": "yellow", "format": "" },
    {
      "type": "disk",
      "key": "│   Sistem    │ ",
      "keyColor": "yellow",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage}) - {filesystem}"
    },
    {
      "type": "disk",
      "key": "│   Lexar     │ ",
      "keyColor": "yellow",
      "folders": "/srv/lexar",
      "format": "{size-used} / {size-total} ({size-percentage}) - {filesystem}"
    },
    {
      "type": "disk",
      "key": "│   Arşiv     │ ",
      "keyColor": "yellow",
      "folders": "/srv/storage",
      "format": "{size-used} / {size-total} ({size-percentage}) - {filesystem}"
    },
    { "type": "custom", "key": "├──────────────┤", "keyColor": "yellow", "format": "" },
    { "type": "sound", "key": "│   Ses       │ ", "keyColor": "yellow" },
    { "type": "media", "key": "│ 󰝚  Çalıyor   │ ", "keyColor": "yellow", "format": "{?artist}{artist} - {?}{title}" },
    { "type": "custom", "key": "├──────────────┤", "keyColor": "yellow", "format": "" },
    { "type": "weather", "key": "│ 󰖐  Hava      │ ", "keyColor": "yellow", "location": "Eskişehir", "timeout": 1000 },
    { "type": "datetime", "key": "│ 󰃰  Tarih/Saat│ ", "keyColor": "yellow" },
    { "type": "custom", "key": "├──────────────┤", "keyColor": "yellow", "format": "" },
    { "type": "colors", "key": "│ 󰏘  Renkler   │ ", "keyColor": "yellow", "symbol": "circle" },
    { "type": "custom", "key": "╰──────────────╯", "keyColor": "yellow", "format": "" },
    "break"
  ]
}
