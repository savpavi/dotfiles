/* Clipboard-only Nord theme. */
configuration {
    font: "sans 12";
    show-icons: false;
}
* {
    background-color: #2e3440;
    text-color: #eceff4;
    border-color: #88c0d0;
}
window {
    width: 650px;
    location: center;
    anchor: center;
    border: 2px;
    border-radius: 12px;
    padding: 16px;
}
mainbox { children: [ inputbar, listview ]; spacing: 12px; }
inputbar { children: [ prompt, entry ]; spacing: 12px; padding: 8px; }
prompt { text-color: #88c0d0; }
entry { placeholder: "Pano geçmişinde ara…"; placeholder-color: #d8dee9; }
listview { lines: 10; columns: 1; fixed-height: false; spacing: 4px; }
element { padding: 9px; border-radius: 6px; }
element normal.normal { background-color: #2e3440; text-color: #eceff4; }
element alternate.normal { background-color: #3b4252; text-color: #eceff4; }
element selected.normal { background-color: #88c0d0; text-color: #2e3440; }
element-text { background-color: inherit; text-color: inherit; }
