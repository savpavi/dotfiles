# Monochrome — Konsole "Monochrome" profiliyle birebir aynı
# Kaynak: ~/.local/share/konsole/Monochrome.colorscheme + Monochrome.profile

background = #080808
foreground = #dcdcdc

cursor-color = #dcdcdc
cursor-style = block
cursor-style-blink = false

# Normal renkler (Konsole Color0-7)
palette = 0=#181818
palette = 1=#be6969
palette = 2=#96af96
palette = 3=#b9af87
palette = 4=#8796af
palette = 5=#a591aa
palette = 6=#8caaaa
palette = 7=#cdcdcd

# Parlak renkler (Konsole Color0-7 Intense)
palette = 8=#505050
palette = 9=#e68787
palette = 10=#bed7be
palette = 11=#e1d7aa
palette = 12=#afc3e1
palette = 13=#cdb4d7
palette = 14=#b4d7d7
palette = 15=#f5f5f5

# Konsole'daki Faint renklerin karşılığı (~0.65 oranında)
faint-opacity = 0.65

# Konsole: Opacity=0.94, Blur=true
background-opacity = 0.94
background-blur = true

# Konsole: Font 11pt, TerminalMargin=8
font-family = JetBrainsMono Nerd Font
font-size = 11
window-padding-x = 8
window-padding-y = 8

command = /usr/bin/zsh
scrollback-limit = 10000000

# Açılış boyutu: 150 sütun x 38 satır
window-width = 150
window-height = 38

# Yeni sekme butonu için ikisi de şart:
# client  -> GTK kendi başlık çubuğunu çizsin (KDE'ninki buton barındıramıyor)
# tabs    -> sekme çubuğu başlık çubuğuyla birleşsin, "+" butonu gelsin
window-decoration = client
gtk-titlebar-style = tabs
window-show-tab-bar = always
gtk-tabs-location = top
