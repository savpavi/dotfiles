# Ghostty — varsayılan terminal (SUPER + Q). Kitty ayarlarından uyarlandı.
# Renkler aktif temadan: dot-shell-theme yazar (templates/apps/ghostty-theme).

command = /usr/bin/zsh

font-family = JetBrainsMono Nerd Font
font-size = 11

background-opacity = 0.94
background-blur = 20
unfocused-split-opacity = 0.65
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
window-decoration = none
gtk-tabs-location = top
window-width = 150
window-height = 38
confirm-close-surface = false

cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

scrollback-limit = 10000000
mouse-hide-while-typing = true
mouse-scroll-multiplier = 2.4
copy-on-select = true
link-url = true
app-notifications = no-clipboard-copy

keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard
keybind = super+n=new_window
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+q=close_tab
keybind = ctrl+shift+right=next_tab
keybind = ctrl+shift+left=previous_tab
keybind = ctrl+shift+enter=new_split:auto
keybind = ctrl+shift+]=goto_split:next
keybind = ctrl+shift+[=goto_split:previous
keybind = ctrl+shift+page_up=scroll_page_up
keybind = ctrl+shift+page_down=scroll_page_down
keybind = ctrl+shift+home=scroll_to_top
keybind = ctrl+shift+end=scroll_to_bottom
keybind = ctrl+shift+backspace=reset_font_size

config-file = ?savpavi-theme
