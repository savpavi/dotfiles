/* dot-theme tarafından üretildi — elle düzenleme.
   style.css'in beklediği Catppuccin isimleri aktif temaya eşlendi. */
@define-color base     {{ background }};
@define-color mantle   {{ dark_background }};
@define-color surface0 {{ lighter_background }};
@define-color surface1 {{ selection }};
@define-color text     {{ foreground }};
@define-color subtext  {{ light_foreground }};
@define-color overlay  {{ muted }};
@define-color mauve    {{ accent }};
@define-color blue     {{ blue }};
@define-color sapphire {{ cyan }};
@define-color green    {{ green }};
@define-color yellow   {{ yellow }};
@define-color peach    {{ orange }};
@define-color red      {{ red }};
