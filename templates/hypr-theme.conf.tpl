# dot-theme tarafından üretildi — elle düzenleme.
# hyprlock.conf içinden `source = ~/.config/hypr/hypr-theme.conf` ile çekilir.
$accent      = rgba({{ accent_strip }}ff)
$background  = rgba({{ background_strip }}ee)
$foreground  = rgba({{ foreground_strip }}ff)
$muted       = rgba({{ muted_strip }}ff)
$subtext     = rgba({{ light_foreground_strip }}ff)
$check_color = rgba({{ blue_strip }}ff)
$fail_color  = rgba({{ red_strip }}ff)
$muted_hex   = {{ muted_strip }}
$fail_hex    = {{ red_strip }}
