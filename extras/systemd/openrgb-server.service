[Unit]
Description=OpenRGB SDK server (dot-rgb, dwl-theme colours)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
# dot-rgb also calls iot_driver (HE75 keyboard) from ~/.local/bin.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
# User config (~/.config/OpenRGB) so ARGB zone sizes set in the GUI apply.
# The GUI started afterwards connects to this server instead of grabbing the devices.
# -v: dot-rgb boot waits for the "Detection completed" line in the journal.
ExecStart=/usr/bin/openrgb --server --server-host 127.0.0.1 --noautoconnect -v
# Waits for detection (~12 s) without connecting (a client during detection makes the
# server misread the devices), checks the result, then paints the theme colour.
ExecStartPost=%h/dotfiles/bin/dot-rgb boot
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
