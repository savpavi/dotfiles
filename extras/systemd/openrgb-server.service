[Unit]
Description=OpenRGB SDK server (dot-rgb, dwl-theme colours)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
# User config (~/.config/OpenRGB) so ARGB zone sizes set in the GUI apply.
# The GUI started afterwards connects to this server instead of grabbing the devices.
ExecStart=/usr/bin/openrgb --server --server-host 127.0.0.1 --noautoconnect
# Detection takes ~10 s; wait for it, then paint the theme colour.
ExecStartPost=-/bin/sh -c 'for i in $(seq 30); do [ "$(openrgb -l 2>/dev/null | wc -l)" -ge 3 ] && break; sleep 1; done; exec %h/dotfiles/bin/dot-rgb'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
