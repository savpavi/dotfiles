[Desktop Entry]
Type=Service
MimeType=all/all;
Actions=drivelink;driveshare
Icon=folder-cloud

[Desktop Action drivelink]
Name=Drive linkini kopyala
Icon=edit-link
Exec=/home/savpavi/dotfiles/bin/dot-drive link %F

[Desktop Action driveshare]
Name=Drive'da herkese açık paylaş
Icon=document-share
Exec=/home/savpavi/dotfiles/bin/dot-drive share %F
